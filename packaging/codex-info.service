[Unit]
Description=Codex Info daemon and loopback REST service
After=default.target
StartLimitIntervalSec=60s
StartLimitBurst=2

[Service]
Type=simple
ExecStartPre=%h/.local/libexec/codex-info-install.sh --startup-reconcile
ExecCondition=%h/.local/libexec/codex-info-install.sh --startup-condition
ExecStart=%h/.local/bin/codex_info --port 8787
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=20s
Environment=CODEX_INFO_DAEMON_INTERVAL_SECS=60
Environment=CODEX_INFO_SYSTEMD_MANAGED=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
