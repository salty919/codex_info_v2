[Unit]
Description=Codex Info recorder
After=default.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/codex_info_recorder
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=20s
Environment=CODEX_INFO_DAEMON_INTERVAL_SECS=60
Environment=CODEX_INFO_SYSTEMD_MANAGED=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
