<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CodexInfo.WindowsClient</AssemblyName>
    <RootNamespace>CodexInfo.WindowsClient</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationIcon>Assets\CodexInfo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexInfo.WindowsClient.Core\CodexInfo.WindowsClient.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\..\assets\NotoSansJP.ttf" Link="Assets\NotoSansJP.ttf" />
    <AvaloniaResource Include="Assets\NotoSansJP-Medium.ttf" />
    <AvaloniaResource Include="Assets\CodexInfo.ico" />
    <AvaloniaResource Include="..\..\..\assets\NotoSansKR.otf" Link="Assets\NotoSansKR.otf" />
    <AvaloniaResource Include="..\..\..\LICENSE" Link="Legal\LICENSE" />
    <AvaloniaResource Include="..\..\..\LICENSE.ja.md" Link="Legal\LICENSE.ja.md" />
    <AvaloniaResource Include="..\..\..\THIRD_PARTY_NOTICES.md" Link="Legal\THIRD_PARTY_NOTICES.md" />
    <AvaloniaResource Include="..\..\..\assets\NOTICE.txt" Link="Legal\NOTICE.txt" />
    <AvaloniaResource Include="..\..\..\windows-client\THIRD_PARTY_NOTICES.md" Link="Legal\Windows-THIRD_PARTY_NOTICES.md" />
    <AvaloniaResource Include="..\..\..\LICENSES\Apache-2.0.txt" Link="Legal\LICENSES\Apache-2.0.txt" />
    <AvaloniaResource Include="..\..\..\LICENSES\BSD-3-Clause-ANGLE.txt" Link="Legal\LICENSES\BSD-3-Clause-ANGLE.txt" />
    <AvaloniaResource Include="..\..\..\LICENSES\Inno-Setup.txt" Link="Legal\LICENSES\Inno-Setup.txt" />
    <AvaloniaResource Include="..\..\..\LICENSES\MIT.txt" Link="Legal\LICENSES\MIT.txt" />
    <AvaloniaResource Include="..\..\..\LICENSES\OFL-1.1.txt" Link="Legal\LICENSES\OFL-1.1.txt" />
    <AvaloniaResource Include="..\..\..\LICENSES\OPENAI-CODEX-NOTICE.txt" Link="Legal\LICENSES\OPENAI-CODEX-NOTICE.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="ScottPlot.Avalonia" Version="5.1.59" />
  </ItemGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Net.SocketsHttpHandler.Http2FlowControl.DisableDynamicWindowSizing" Value="true" />
  </ItemGroup>
</Project>
