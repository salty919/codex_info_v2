<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodexInfo.WindowsClient.ViewModels"
        x:Class="CodexInfo.WindowsClient.LegalNoticesWindow"
        x:DataType="vm:LegalNoticesWindowViewModel"
        Width="900"
        Height="480"
        MinWidth="900"
        MinHeight="480"
        MaxWidth="900"
        MaxHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Title="Codex Info License"
        FontFamily="{StaticResource JapaneseFont}"
        Background="{DynamicResource Theme0E141E}"
        Foreground="{DynamicResource ThemeE9EFF8}">
  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeA8B7CA}" />
    </Style>
    <Style Selector="Border.notice-card">
      <Setter Property="Background" Value="{DynamicResource Theme151F2D}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme263548}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeA8B7CA}" />
    </Style>
    <Style Selector="Button.window-control:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme263548}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeF2F6FC}" />
    </Style>
    <Style Selector="Button.page-nav">
      <Setter Property="MinWidth" Value="76" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Background" Value="{DynamicResource Theme1B2A3A}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme36516B}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeE9EFF8}" />
    </Style>
    <Style Selector="Button.page-nav:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme294968}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme5EA7E5}" />
    </Style>
    <Style Selector="Button.page-nav:disabled">
      <Setter Property="Background" Value="{DynamicResource Theme111A27}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme263548}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme718196}" />
    </Style>
  </Window.Styles>
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" Background="Transparent" PointerPressed="OnTitlePointerPressed">
      <StackPanel><TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Texts.LicenseInformation}" /></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
        <Button Classes="window-control" Click="OnMinimizeWindow" AutomationProperties.Name="{Binding Texts.Minimize}" AutomationProperties.AutomationId="Legal.Window.Minimize" Content="—" ToolTip.Tip="{Binding Texts.Minimize}" />
        <Button Classes="window-control" Click="OnCloseWindow" AutomationProperties.Name="{Binding Texts.Close}" AutomationProperties.AutomationId="Legal.Window.Close" Content="×" ToolTip.Tip="{Binding Texts.Close}" />
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="1" Classes="label" Text="{Binding DetailsStatusText}" />
    <Border Grid.Row="2" Classes="notice-card">
      <ScrollViewer IsVisible="{Binding HasNotices}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="7">
          <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding CurrentNoticeName}"
                     AutomationProperties.AutomationId="Legal.Notice.Name" />
          <TextBlock Classes="label" Text="{Binding CurrentNoticeText}" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="Legal.Notice.Text" />
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding PagePositionText}"
                 AutomationProperties.AutomationId="Legal.Page.Position" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="page-nav" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}"
                AutomationProperties.Name="{Binding BackText}" AutomationProperties.AutomationId="Legal.Page.Back"
                ToolTip.Tip="{Binding BackText}" Content="{Binding BackText}" />
        <Button Classes="page-nav" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}"
                AutomationProperties.Name="{Binding NextText}" AutomationProperties.AutomationId="Legal.Page.Next"
                ToolTip.Tip="{Binding NextText}" Content="{Binding NextText}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
