<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodexInfo.WindowsClient.ViewModels"
        x:Class="CodexInfo.WindowsClient.SetupWindow"
        x:DataType="vm:SetupViewModel"
        Width="900" Height="480" MinWidth="900" MinHeight="480" MaxWidth="900" MaxHeight="480"
        WindowStartupLocation="CenterOwner" CanResize="False"
        WindowDecorations="None" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="0"
        Title="{Binding WindowTitle}" FontFamily="{StaticResource JapaneseFont}"
        Background="{DynamicResource Theme0E141E}" Foreground="{DynamicResource ThemeE9EFF8}">
  <Window.Styles>
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{DynamicResource ThemeA8B7CA}" /></Style>
    <Style Selector="Border.surface"><Setter Property="Background" Value="{DynamicResource Theme151F2D}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme2C4258}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /></Style>
    <Style Selector="Border.step">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.step.current">
      <Setter Property="Background" Value="{DynamicResource Theme18283A}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme56B2F5}" />
    </Style>
  </Window.Styles>
  <Grid Margin="28" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto" Background="Transparent" PointerPressed="OnTitlePointerPressed">
      <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Classes="heading-icon" Data="{StaticResource IconConnection}" /><StackPanel VerticalAlignment="Center"><TextBlock Classes="window-title" Text="{Binding PageTitle}" /><TextBlock Classes="label" Text="{Binding Texts.Setup}" IsVisible="{Binding !IsConnectionSettings}" /></StackPanel></StackPanel>
      <Button Grid.Column="1" Classes="window-control" Click="OnClose" AutomationProperties.Name="{Binding Texts.Close}" AutomationProperties.AutomationId="Setup.Window.Close" Content="×" ToolTip.Tip="{Binding Texts.Close}" />
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <Border Classes="step" Classes.current="{Binding IsConnectionStep}"><TextBlock Text="{Binding Texts.StepConnection}" /></Border>
      <Border Classes="step" Classes.current="{Binding IsAuthStep}"><TextBlock Text="{Binding Texts.StepAuth}" /></Border>
      <Border Classes="step" Classes.current="{Binding IsDoneStep}"><TextBlock Text="{Binding Texts.StepDone}" /></Border>
    </StackPanel>
    <Border Grid.Row="2" Classes="surface" Padding="22">
      <!-- Keep a real content gutter for the vertical scrollbar.  Avalonia's
           overlay scrollbar can otherwise paint over the last glyph of a
           wrapped Japanese/Arabic line at the minimum width. -->
      <ScrollViewer Padding="0,0,18,0" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="0,0,2,0">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <StackPanel Spacing="5">
              <TextBlock Classes="label" Text="{Binding Texts.ConnectionProfileLabel}" />
              <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ConnectionProfileOptions}"
                        SelectedValue="{Binding SelectedConnectionProfile, Mode=TwoWay}"
                        SelectedValueBinding="{Binding Id}"
                        AutomationProperties.Name="{Binding Texts.ConnectionProfileLabel}"
                        ToolTip.Tip="{Binding Texts.ConnectionProfileLabel}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5" IsVisible="{Binding HasConnectionSelector}">
              <TextBlock Classes="label" Text="{Binding Texts.ConnectionSelectorLabel}" />
              <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ConnectionSelectorOptions}"
                        SelectedItem="{Binding SelectedConnectionSelector, Mode=TwoWay}"
                        PlaceholderText="{Binding Texts.ConnectionSelectorPlaceholder}"
                        AutomationProperties.Name="{Binding Texts.ConnectionSelectorLabel}"
                        ToolTip.Tip="{Binding Texts.ConnectionSelectorLabel}" />
            </StackPanel>
          </Grid>
          <Border Background="{DynamicResource Theme101F2D}" CornerRadius="8" Padding="14"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><TextBlock Text="●" Foreground="{DynamicResource Theme71C7FF}" VerticalAlignment="Top" Margin="0,3,0,0" /><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{Binding StatusTitle}" /><TextBlock Classes="label" Text="{Binding StatusDetail}" TextWrapping="Wrap" /></StackPanel></Grid></Border>
          <Button Classes="primary" HorizontalAlignment="Left" IsVisible="{Binding CanAuthenticate}"
                  Click="OnAuth" Content="{Binding Texts.AuthStart}" />
          <Expander Header="{Binding Texts.ConnectionGuide}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="12">
              <TextBlock Classes="label" Text="{Binding Texts.SetupIntro}" TextWrapping="Wrap" />
              <TextBlock Classes="label" Text="{Binding Texts.ConnectionGuideBody}" TextWrapping="Wrap" />

          <StackPanel Spacing="5">
            <TextBlock Classes="label" Text="{Binding Texts.SshConfigAliasLabel}" />
            <ComboBox ItemsSource="{Binding SshConfigAliases}" SelectedItem="{Binding SelectedSshConfigAlias, Mode=TwoWay}" PlaceholderText="{Binding Texts.SshConfigAliasPlaceholder}" AutomationProperties.Name="{Binding Texts.SshConfigAliasLabel}" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <StackPanel Spacing="5">
              <TextBlock Classes="label" Text="{Binding Texts.SshUserLabel}" />
              <TextBox Text="{Binding SshUser, Mode=TwoWay}" PlaceholderText="{Binding Texts.SshUserPlaceholder}" AutomationProperties.Name="{Binding Texts.SshUserLabel}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Classes="label" Text="{Binding Texts.SshHostLabel}" />
              <TextBox Text="{Binding SshHost, Mode=TwoWay}" PlaceholderText="{Binding Texts.SshHostPlaceholder}" AutomationProperties.Name="{Binding Texts.SshHostLabel}" />
            </StackPanel>
          </Grid>
          <Border Background="{DynamicResource Theme0A111A}" CornerRadius="8" Padding="12">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
              <TextBlock FontFamily="Consolas" MinWidth="0" Text="{Binding SshCommand}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Classes="label" Foreground="{DynamicResource ThemeE7C26A}" Text="{Binding SshStatusText}" TextWrapping="Wrap" />
              <Button Grid.Row="2" HorizontalAlignment="Right" Classes="secondary" Click="OnCopySsh" AutomationProperties.Name="{Binding Texts.Copy}" ToolTip.Tip="{Binding Texts.Copy}" Content="{Binding Texts.Copy}" />
            </Grid>
          </Border>
          <TextBlock Classes="label" Text="Linux / WSL" />
          <Border Background="{DynamicResource Theme0A111A}" CornerRadius="8" Padding="12">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
              <TextBlock FontFamily="Consolas" MinWidth="0" Text="{Binding ApiCommand}" TextWrapping="Wrap" />
              <Button Grid.Row="1" HorizontalAlignment="Right" Classes="secondary" Click="OnCopyApi" AutomationProperties.Name="{Binding Texts.Copy}" ToolTip.Tip="{Binding Texts.Copy}" Content="{Binding Texts.Copy}" />
            </Grid>
          </Border>
      <Button Classes="primary" IsEnabled="{Binding CanStartSsh}" Click="OnStartOrStopSsh" AutomationProperties.Name="{Binding SshActionText}" ToolTip.Tip="{Binding SshActionText}" Content="{Binding SshActionText}" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">

      <Button Classes="secondary" Click="OnRefresh" IsVisible="{Binding !IsDoneStep}" IsEnabled="{Binding CanRefresh}" AutomationProperties.AutomationId="Setup.Refresh" AutomationProperties.Name="{Binding RefreshButtonText}" ToolTip.Tip="{Binding RefreshButtonText}" Content="{Binding RefreshButtonText}" />
      <Button Classes="secondary" IsVisible="{Binding !IsDoneStep}" Click="OnClose" AutomationProperties.Name="{Binding Texts.Close}" ToolTip.Tip="{Binding Texts.Close}" Content="{Binding Texts.Close}" />
      <Button Classes="primary" IsEnabled="{Binding CanContinue}" Click="OnContinue" AutomationProperties.Name="{Binding ContinueText}" ToolTip.Tip="{Binding ContinueText}" Content="{Binding ContinueText}" />
    </StackPanel>
  <Border Classes="window-frame" Classes.active="{Binding $parent[Window].IsActive}"
            Grid.RowSpan="4" Margin="-28" IsHitTestVisible="False" />
  </Grid>
</Window>
