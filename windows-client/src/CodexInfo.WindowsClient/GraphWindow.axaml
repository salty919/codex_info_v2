<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodexInfo.WindowsClient.ViewModels"
        xmlns:core="using:CodexInfo.WindowsClient.Core"
        xmlns:plot="using:CodexInfo.WindowsClient.Controls"
        xmlns:controls="using:CodexInfo.WindowsClient.Controls"
        x:Class="CodexInfo.WindowsClient.GraphWindow"
        x:DataType="vm:GraphWindowViewModel"
        Width="940"
        Height="640"
        MinWidth="700"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Title="Codex Info Graph"
        FontFamily="{StaticResource JapaneseFont}"
        Background="#0E141E"
        Foreground="#E9EFF8">
  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#78879C" />
    </Style>
    <Style Selector="ToggleButton.series-toggle">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#E9EFF8" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.series-toggle:checked">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.series-toggle:pointerover">
      <Setter Property="Background" Value="#1A2838" />
    </Style>
    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Background" Value="#111B2C" />
      <Setter Property="BorderBrush" Value="#2D3D56" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Foreground" Value="#A8B7CA" />
    </Style>
    <Style Selector="Button.window-control:pointerover">
      <Setter Property="Background" Value="#263548" />
      <Setter Property="Foreground" Value="#F2F6FC" />
    </Style>
  </Window.Styles>

  <Grid>
    <Grid x:Name="GraphContent" Margin="30,24" RowDefinitions="36,36,36,36,32,*">
      <Border Grid.Row="1" Grid.RowSpan="4" Margin="0,6,0,0" Background="#111B2C" />

      <Grid Grid.Row="0" ColumnDefinitions="*,128,8,108" Background="Transparent">
        <TextBlock Margin="0,0,8,0" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding Texts.GraphWindowTitle}" />
        <controls:GraphSelect x:Name="MetricSelector" Grid.Column="1"
                              ValueText="{Binding SelectedMetric}"
                              ItemsSource="{Binding MetricOptions}"
                              SelectedItem="{Binding SelectedMetric, Mode=TwoWay}"
                              MenuAutomationId="Graph.MetricMenu"
                              PopupWidth="128" PopupOnLeft="True" MaxVisibleItems="4"
                              AutomationProperties.Name="{Binding Texts.ModelUsage}"
                              AutomationProperties.AutomationId="Graph.MetricSelector"
                              AutomationProperties.HelpText="{Binding SelectedMetric}"
                              ToolTip.Tip="{Binding Texts.ModelUsage}" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="0" VerticalAlignment="Top">
          <Button Classes="window-control" Click="OnMinimizeWindow" AutomationProperties.Name="{Binding Texts.Minimize}" AutomationProperties.AutomationId="Graph.Window.Minimize" Content="—" ToolTip.Tip="{Binding Texts.Minimize}" />
          <Button Classes="window-control" Click="OnMaximizeWindow" AutomationProperties.Name="{Binding Texts.Maximize}" AutomationProperties.AutomationId="Graph.Window.Maximize" Content="□" ToolTip.Tip="{Binding Texts.Maximize}" />
          <Button Classes="window-control" Click="OnCloseWindow" AutomationProperties.Name="{Binding Texts.Close}" AutomationProperties.AutomationId="Graph.Window.Close" Content="×" ToolTip.Tip="{Binding Texts.Close}" />
        </StackPanel>
      </Grid>

      <controls:GraphSelect x:Name="AccountSelector" Grid.Row="1" Margin="0,6,0,0"
                            FieldLabel="{Binding Texts.Account}" HasFieldLabel="True" ValueMargin="17,0,0,0"
                            ValueText="{Binding SelectedAccountValueText}"
                            ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                            MenuAutomationId="Graph.AccountMenu" PopupWidth="560" MaxVisibleItems="4"
                            IsEnabled="{Binding HasAccounts}" AutomationProperties.Name="{Binding Texts.Account}"
                            AutomationProperties.AutomationId="Graph.AccountSelector"
                            AutomationProperties.HelpText="{Binding SelectedAccountText}"
                            ToolTip.Tip="{Binding SelectedAccountText}">
        <controls:GraphSelect.ItemTemplate>
          <DataTemplate x:DataType="core:ApiAccount">
            <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap"
                       ToolTip.Tip="{Binding DisplayLabel}"
                       AutomationProperties.Name="{Binding DisplayLabel}"
                       AutomationProperties.HelpText="{Binding DisplayLabel}" />
          </DataTemplate>
        </controls:GraphSelect.ItemTemplate>
      </controls:GraphSelect>

      <controls:GraphSelect x:Name="PeriodSelector" Grid.Row="2" Margin="0,12,0,0"
                            FieldLabel="{Binding Texts.PeriodSelectorHeading}" HasFieldLabel="True" ValueMargin="17,0,0,0"
                            ValueText="{Binding SelectedPeriodValueText}"
                            ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}"
                            MenuAutomationId="Graph.PeriodMenu" PopupWidth="620" LimitPopupToField="True" MaxVisibleItems="10"
                            IsEnabled="{Binding HasPeriods}" AutomationProperties.Name="{Binding Texts.PeriodSelectorHeading}"
                            AutomationProperties.AutomationId="Graph.PeriodSelector"
                            AutomationProperties.HelpText="{Binding SelectedPeriodText}"
                            ToolTip.Tip="{Binding SelectedPeriodText}">
        <controls:GraphSelect.ItemTemplate>
          <DataTemplate x:DataType="core:ApiHistoryPeriod">
            <TextBlock Text="{Binding Label}" TextWrapping="Wrap"
                       ToolTip.Tip="{Binding Label}"
                       AutomationProperties.Name="{Binding Label}"
                       AutomationProperties.HelpText="{Binding Label}" />
          </DataTemplate>
        </controls:GraphSelect.ItemTemplate>
      </controls:GraphSelect>

      <Grid Grid.Row="4" Width="504" Height="24" HorizontalAlignment="Left"
            ColumnDefinitions="120,90,90,90,90" ColumnSpacing="6">
      <ToggleButton Classes="series-toggle" ClickMode="Press" IsChecked="{Binding ShowRemaining}" AutomationProperties.Name="{Binding Texts.RemainingQuota}" AutomationProperties.AutomationId="Graph.Toggle.Remaining" ToolTip.Tip="{Binding Texts.RemainingQuota}">
        <Grid ColumnDefinitions="28,*"><Border Width="14" Height="4" Margin="8,0,6,0" CornerRadius="2" Background="#56B2F5" HorizontalAlignment="Left" VerticalAlignment="Center" /><TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Texts.RemainingQuota}" /></Grid>
      </ToggleButton>
      <ToggleButton Grid.Column="1" Classes="series-toggle" ClickMode="Press" IsChecked="{Binding ShowLuna}" AutomationProperties.Name="LUNA" AutomationProperties.AutomationId="Graph.Toggle.LUNA" ToolTip.Tip="LUNA">
        <Grid ColumnDefinitions="28,*"><Border Width="14" Height="4" Margin="8,0,6,0" CornerRadius="2" Background="#E6A23C" HorizontalAlignment="Left" VerticalAlignment="Center" /><TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="LUNA" /></Grid>
      </ToggleButton>
      <ToggleButton Grid.Column="2" Classes="series-toggle" ClickMode="Press" IsChecked="{Binding ShowTerra}" AutomationProperties.Name="TERRA" AutomationProperties.AutomationId="Graph.Toggle.TERRA" ToolTip.Tip="TERRA">
        <Grid ColumnDefinitions="28,*"><Border Width="14" Height="4" Margin="8,0,6,0" CornerRadius="2" Background="#5DC98A" HorizontalAlignment="Left" VerticalAlignment="Center" /><TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="TERRA" /></Grid>
      </ToggleButton>
      <ToggleButton Grid.Column="3" Classes="series-toggle" ClickMode="Press" IsChecked="{Binding ShowSol}" AutomationProperties.Name="SOL" AutomationProperties.AutomationId="Graph.Toggle.SOL" ToolTip.Tip="SOL">
        <Grid ColumnDefinitions="28,*"><Border Width="14" Height="4" Margin="8,0,6,0" CornerRadius="2" Background="#A88CF5" HorizontalAlignment="Left" VerticalAlignment="Center" /><TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="SOL" /></Grid>
      </ToggleButton>
      <ToggleButton Grid.Column="4" Classes="series-toggle" ClickMode="Press" IsChecked="{Binding ShowAstra}" AutomationProperties.Name="ASTRA" AutomationProperties.AutomationId="Graph.Toggle.ASTRA" ToolTip.Tip="ASTRA">
        <Grid ColumnDefinitions="28,*"><Border Width="14" Height="4" Margin="8,0,6,0" CornerRadius="2" Background="#EF6A6A" HorizontalAlignment="Left" VerticalAlignment="Center" /><TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="ASTRA" /></Grid>
      </ToggleButton>
      </Grid>

      <Border Grid.Row="5" Background="#121C2C" BorderBrush="#3B506F" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid>
          <plot:GraphPlotControl Scene="{Binding Scene}"
                               ShowRemaining="{Binding ShowRemaining}" ShowSol="{Binding ShowSol}"
                               ShowTerra="{Binding ShowTerra}" ShowLuna="{Binding ShowLuna}"
                               ShowAstra="{Binding ShowAstra}"
                               AutomationProperties.Name="{Binding Texts.Graph}"
                               AutomationProperties.AutomationId="Graph.Plot"
                               IsVisible="{Binding HasPoints}" />
          <TextBlock Classes="label" Margin="92,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                     FontWeight="SemiBold" Text="{Binding MetricAxisText}" IsHitTestVisible="False" />
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                      IsVisible="{Binding IsLoading}" IsHitTestVisible="False">
            <ProgressBar Width="72" Height="4" IsIndeterminate="True" />
            <TextBlock Classes="label" Text="{Binding LoadingText}" />
          </StackPanel>
          <TextBlock Classes="label" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding HasBlockingLoadError}" IsHitTestVisible="False"
                     Foreground="#F0A35B" Text="{Binding LoadErrorText}" />
          <TextBlock Classes="label" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding HasNoPoints}" IsHitTestVisible="False"
                     Text="{Binding Texts.UnavailableDetails}" />
        </Grid>
      </Border>

    </Grid>

    <Border x:Name="ResizeNorthWest" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" PointerPressed="OnResizeNorthWest" />
    <Border x:Name="ResizeNorthEast" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" PointerPressed="OnResizeNorthEast" />
    <Border x:Name="ResizeSouthWest" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" PointerPressed="OnResizeSouthWest" />
    <Border x:Name="ResizeSouthEast" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" PointerPressed="OnResizeSouthEast" />
    <Border x:Name="ResizeNorth" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="18,0" Background="Transparent" PointerPressed="OnResizeNorth" />
    <Border x:Name="ResizeSouth" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="18,0" Background="Transparent" PointerPressed="OnResizeSouth" />
    <Border x:Name="ResizeWest" Width="10" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,18" Background="Transparent" PointerPressed="OnResizeWest" />
    <Border x:Name="ResizeEast" Width="10" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,18" Background="Transparent" PointerPressed="OnResizeEast" />
  </Grid>
</Window>
