<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodexInfo.WindowsClient.ViewModels"
        xmlns:core="using:CodexInfo.WindowsClient.Core"
        xmlns:plot="using:CodexInfo.WindowsClient.Controls"
        xmlns:controls="using:CodexInfo.WindowsClient.Controls"
        x:Class="CodexInfo.WindowsClient.GraphWindow"
        x:DataType="vm:GraphWindowViewModel"
        Width="940"
        Height="640"
        MinWidth="700"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Title="Codex Info Graph"
        FontFamily="{StaticResource JapaneseFont}"
        Background="{DynamicResource Theme0E141E}"
        Foreground="{DynamicResource ThemeE9EFF8}">
  <Window.Styles>
    <Style Selector="controls|GraphSelect.graph-select-field">
      <Setter Property="Background" Value="{DynamicResource Theme111B2C}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme405779}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="controls|GraphSelect.graph-select-field:checked">
      <Setter Property="Background" Value="{DynamicResource Theme244D74}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme56B2F5}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Theme78879C}" />
    </Style>
    <Style Selector="ToggleButton.series-toggle">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeE9EFF8}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.series-toggle:checked">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.series-toggle:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme1A2838}" />
    </Style>
    <Style Selector="Button.range-mode">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource Theme111B2C}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeA8B7CA}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme2D3D56}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.range-mode.selected">
      <Setter Property="Background" Value="{DynamicResource Theme244D74}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeF2F6FC}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme56B2F5}" />
    </Style>
    <Style Selector="Button.range-mode:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme263548}" />
    </Style>
    <Style Selector="ToggleSwitch.metric-switch">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="OnContent" Value="{x:Null}" />
      <Setter Property="OffContent" Value="{x:Null}" />
    </Style>
    <Style Selector="ToggleSwitch.metric-switch /template/ Border#OuterBorder">
      <Setter Property="Background" Value="{DynamicResource Theme111B2C}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme405779}" />
    </Style>
    <Style Selector="ToggleSwitch.metric-switch:checked /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="{DynamicResource Theme244D74}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme56B2F5}" />
    </Style>
    <Style Selector="ToggleSwitch.metric-switch /template/ Ellipse#SwitchKnobOff">
      <Setter Property="Fill" Value="{DynamicResource ThemeA8B7CA}" />
    </Style>
    <Style Selector="ToggleSwitch.metric-switch /template/ Ellipse#SwitchKnobOn">
      <Setter Property="Fill" Value="{DynamicResource ThemeF2F6FC}" />
    </Style>
    <Style Selector="Button.range-nav">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource Theme111B2C}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeA8B7CA}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme2D3D56}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.range-nav:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme263548}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeF2F6FC}" />
    </Style>
    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Background" Value="{DynamicResource Theme111B2C}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme2D3D56}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeA8B7CA}" />
    </Style>
    <Style Selector="Button.window-control:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme263548}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeF2F6FC}" />
    </Style>
  </Window.Styles>

  <Grid>
    <Grid x:Name="GraphContent" Margin="30,16" RowDefinitions="36,40,28,*" RowSpacing="8">
      <Border Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource Theme111B2C}" CornerRadius="10" />

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,16,Auto" Background="Transparent">
        <TextBlock Margin="0,0,8,0" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"
                   Text="{Binding Texts.GraphWindowTitle}" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding Texts.GraphDollarMetric}" />
          <ToggleSwitch Classes="metric-switch"
                        IsChecked="{Binding IsTokensMetric, Mode=TwoWay}"
                        AutomationProperties.HelpText="{Binding IsTokensMetric}"
                        AutomationProperties.AutomationId="Graph.Metric.Switch">
            <AutomationProperties.Name>
              <MultiBinding StringFormat="{}{0} / {1}">
                <Binding Path="Texts.GraphDollarMetric" />
                <Binding Path="Texts.GraphTokenMetric" />
              </MultiBinding>
            </AutomationProperties.Name>
          </ToggleSwitch>
          <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding Texts.GraphTokenMetric}" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
          <Button Classes="window-control" Click="OnMinimizeWindow" AutomationProperties.Name="{Binding Texts.Minimize}" AutomationProperties.AutomationId="Graph.Window.Minimize" Content="—" ToolTip.Tip="{Binding Texts.Minimize}" />
          <Button Classes="window-control" Click="OnMaximizeWindow" AutomationProperties.Name="{Binding Texts.Maximize}" AutomationProperties.AutomationId="Graph.Window.Maximize" Content="□" ToolTip.Tip="{Binding Texts.Maximize}" />
          <Button Classes="window-control" Click="OnCloseWindow" AutomationProperties.Name="{Binding Texts.Close}" AutomationProperties.AutomationId="Graph.Window.Close" Content="×" ToolTip.Tip="{Binding Texts.Close}" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,4">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="range-mode" Classes.selected="{Binding IsPeriodView}" Tag="Period" Click="OnTimeRangeClick"
                  Content="{Binding Texts.GraphPeriodRange}" AutomationProperties.AutomationId="Graph.Range.Period" />
          <Button Classes="range-mode" Classes.selected="{Binding Is24HourView}" Tag="Day" Click="OnTimeRangeClick"
                  Content="{Binding Texts.GraphDayRange}" AutomationProperties.AutomationId="Graph.Range.Day" />
          <Button Classes="range-mode" Classes.selected="{Binding IsWeekView}" Tag="Week" Click="OnTimeRangeClick"
                  Content="{Binding Texts.GraphWeekRange}" AutomationProperties.AutomationId="Graph.Range.Week" />
        </StackPanel>
        <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   Text="{Binding RangeLabel}" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsPeriodView}"
                   AutomationProperties.Name="{Binding RangeLabel}" AutomationProperties.AutomationId="Graph.Range.Label"
                   ToolTip.Tip="{Binding RangeLabel}" />
        <controls:GraphSelect x:Name="PeriodSelector" Grid.Column="1" Grid.Row="0" Margin="8,0"
                              MinWidth="0" Height="30" HorizontalAlignment="Stretch" IsVisible="{Binding IsPeriodView}"
                              HasFieldLabel="False" ValueMargin="0"
                              ValueText="{Binding SelectedPeriodValueText}"
                              ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}"
                              MenuAutomationId="Graph.PeriodMenu" PopupWidth="620" LimitPopupToField="True" MaxVisibleItems="10"
                              IsEnabled="{Binding HasPeriods}"
                              AutomationProperties.Name="{Binding Texts.PeriodSelectorHeading}"
                              AutomationProperties.AutomationId="Graph.PeriodSelector"
                              AutomationProperties.HelpText="{Binding SelectedPeriodText}"
                              ToolTip.Tip="{Binding SelectedPeriodText}">
          <controls:GraphSelect.ItemTemplate>
            <DataTemplate x:DataType="core:ApiHistoryPeriod">
              <TextBlock Text="{Binding Label}" TextWrapping="Wrap"
                         ToolTip.Tip="{Binding Label}"
                         AutomationProperties.Name="{Binding Label}"
                         AutomationProperties.HelpText="{Binding Label}" />
            </DataTemplate>
          </controls:GraphSelect.ItemTemplate>
        </controls:GraphSelect>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="range-nav" Click="OnPreviousRange" IsEnabled="{Binding CanGoBack}"
                  AutomationProperties.Name="{Binding Texts.GraphPreviousRange}"
                  ToolTip.Tip="{Binding Texts.GraphPreviousRange}" AutomationProperties.AutomationId="Graph.Range.Previous">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock FontSize="16" Text="‹" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Texts.GraphPreviousRangeShort}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="range-nav" Click="OnNextRange" IsEnabled="{Binding CanGoForward}"
                  AutomationProperties.Name="{Binding Texts.GraphNextRange}"
                  ToolTip.Tip="{Binding Texts.GraphNextRange}" AutomationProperties.AutomationId="Graph.Range.Next">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding Texts.GraphNextRangeShort}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock FontSize="16" Text="›" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2" Width="504" Height="24" Margin="4,1,0,1" HorizontalAlignment="Left"
            ColumnDefinitions="120,90,90,90,90" ColumnSpacing="6">
      <ToggleButton Classes="series-toggle" ClickMode="Press" IsChecked="{Binding ShowRemaining}" AutomationProperties.Name="{Binding Texts.RemainingQuota}" AutomationProperties.AutomationId="Graph.Toggle.Remaining" ToolTip.Tip="{Binding Texts.RemainingQuota}">
        <Grid ColumnDefinitions="28,*"><Border Width="14" Height="4" Margin="8,0,6,0" CornerRadius="2" Background="{DynamicResource GraphRemaining}" HorizontalAlignment="Left" VerticalAlignment="Center" /><TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Texts.RemainingQuota}" /></Grid>
      </ToggleButton>
      <ToggleButton Grid.Column="1" Classes="series-toggle" ClickMode="Press" IsChecked="{Binding ShowLuna}" AutomationProperties.Name="LUNA" AutomationProperties.AutomationId="Graph.Toggle.LUNA" ToolTip.Tip="LUNA">
        <Grid ColumnDefinitions="28,*"><Border Width="14" Height="4" Margin="8,0,6,0" CornerRadius="2" Background="{DynamicResource GraphLuna}" HorizontalAlignment="Left" VerticalAlignment="Center" /><TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="LUNA" /></Grid>
      </ToggleButton>
      <ToggleButton Grid.Column="2" Classes="series-toggle" ClickMode="Press" IsChecked="{Binding ShowTerra}" AutomationProperties.Name="TERRA" AutomationProperties.AutomationId="Graph.Toggle.TERRA" ToolTip.Tip="TERRA">
        <Grid ColumnDefinitions="28,*"><Border Width="14" Height="4" Margin="8,0,6,0" CornerRadius="2" Background="{DynamicResource GraphTerra}" HorizontalAlignment="Left" VerticalAlignment="Center" /><TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="TERRA" /></Grid>
      </ToggleButton>
      <ToggleButton Grid.Column="3" Classes="series-toggle" ClickMode="Press" IsChecked="{Binding ShowSol}" AutomationProperties.Name="SOL" AutomationProperties.AutomationId="Graph.Toggle.SOL" ToolTip.Tip="SOL">
        <Grid ColumnDefinitions="28,*"><Border Width="14" Height="4" Margin="8,0,6,0" CornerRadius="2" Background="{DynamicResource GraphSol}" HorizontalAlignment="Left" VerticalAlignment="Center" /><TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="SOL" /></Grid>
      </ToggleButton>
      <ToggleButton Grid.Column="4" Classes="series-toggle" ClickMode="Press" IsChecked="{Binding ShowAstra}" AutomationProperties.Name="ASTRA" AutomationProperties.AutomationId="Graph.Toggle.ASTRA" ToolTip.Tip="ASTRA">
        <Grid ColumnDefinitions="28,*"><Border Width="14" Height="4" Margin="8,0,6,0" CornerRadius="2" Background="{DynamicResource GraphAstra}" HorizontalAlignment="Left" VerticalAlignment="Center" /><TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="ASTRA" /></Grid>
      </ToggleButton>
      </Grid>

      <Grid Grid.Row="3" x:Name="GraphFrame">
        <Border Background="{DynamicResource Theme121C2C}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
          <Grid>
            <plot:GraphPlotControl Scene="{Binding Scene}"
                                   ShowRemaining="{Binding ShowRemaining}" ShowSol="{Binding ShowSol}"
                                   ShowTerra="{Binding ShowTerra}" ShowLuna="{Binding ShowLuna}"
                                   ShowAstra="{Binding ShowAstra}"
                                   AutomationProperties.Name="{Binding Texts.Graph}"
                                   AutomationProperties.HelpText="{Binding MetricAxisText}"
                                   AutomationProperties.AutomationId="Graph.Plot"
                                   IsVisible="{Binding HasPlot}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                        IsVisible="{Binding IsLoading}" IsHitTestVisible="False">
              <ProgressBar Width="72" Height="4" IsIndeterminate="True" />
              <TextBlock Classes="label" Text="{Binding LoadingText}" />
            </StackPanel>
            <TextBlock Classes="label" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding HasBlockingLoadError}" IsHitTestVisible="False"
                       Foreground="{DynamicResource ThemeF0A35B}" Text="{Binding LoadErrorText}" />
            <TextBlock Classes="label" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding HasNoPoints}" IsHitTestVisible="False"
                       Text="{Binding Texts.UnavailableDetails}" />
          </Grid>
        </Border>
        <Border x:Name="GraphFrameOutline" BorderBrush="{DynamicResource Theme3B506F}"
                BorderThickness="1" CornerRadius="10" IsHitTestVisible="False" />
      </Grid>

    </Grid>

    <Border x:Name="ResizeNorthWest" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" PointerPressed="OnResizeNorthWest" />
    <Border x:Name="ResizeNorthEast" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" PointerPressed="OnResizeNorthEast" />
    <Border x:Name="ResizeSouthWest" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" PointerPressed="OnResizeSouthWest" />
    <Border x:Name="ResizeSouthEast" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" PointerPressed="OnResizeSouthEast" />
    <Border x:Name="ResizeNorth" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="18,0" Background="Transparent" PointerPressed="OnResizeNorth" />
    <Border x:Name="ResizeSouth" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="18,0" Background="Transparent" PointerPressed="OnResizeSouth" />
    <Border x:Name="ResizeWest" Width="10" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,18" Background="Transparent" PointerPressed="OnResizeWest" />
    <Border x:Name="ResizeEast" Width="10" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,18" Background="Transparent" PointerPressed="OnResizeEast" />
  </Grid>
</Window>
