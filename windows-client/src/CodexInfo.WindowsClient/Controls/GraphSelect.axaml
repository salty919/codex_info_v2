<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CodexInfo.WindowsClient.Controls.GraphSelect"
             x:Name="Root"
             Height="36">
  <Grid>
    <Border x:Name="Field" Height="36" CornerRadius="6" BorderThickness="1"
            BorderBrush="#405779" Background="#111B2C"
            PointerPressed="OnFieldPressed">
      <Grid ColumnDefinitions="Auto,*,14" Margin="12,0">
        <Grid Grid.Column="0" ColumnDefinitions="82,1" IsVisible="{Binding HasFieldLabel, ElementName=Root}">
          <TextBlock VerticalAlignment="Center" Foreground="#56B2F5" FontSize="11"
                     Text="{Binding FieldLabel, ElementName=Root}" TextTrimming="CharacterEllipsis" />
          <Rectangle Grid.Column="1" Width="1" Height="20" Margin="7,0,0,0" Fill="#405779" />
        </Grid>
        <TextBlock Grid.Column="1" Margin="{Binding ValueMargin, ElementName=Root}"
                   VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"
                   Text="{Binding ValueText, ElementName=Root}" />
        <TextBlock x:Name="Chevron" Grid.Column="2" HorizontalAlignment="Center"
                   VerticalAlignment="Center" FontSize="16" Foreground="#A8B7CA" Text="⌄" />
      </Grid>
    </Border>
    <Popup x:Name="MenuPopup" IsLightDismissEnabled="False">
      <Border x:Name="PopupSurface" CornerRadius="6" BorderThickness="1"
              BorderBrush="#405779" Background="#111B2C" ClipToBounds="True">
        <ListBox x:Name="MenuList" ItemsSource="{Binding ItemsSource, ElementName=Root}"
                 SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}"
                 ItemTemplate="{Binding ItemTemplate, ElementName=Root}"
                 AutomationProperties.AutomationId="{Binding MenuAutomationId, ElementName=Root}"
                 SelectionChanged="OnSelectionChanged" PointerReleased="OnMenuPointerReleased"
                 Background="Transparent" BorderThickness="0" Padding="0">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Height" Value="32" />
              <Setter Property="Padding" Value="11,0" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style Selector="ListBoxItem:selected">
              <Setter Property="Background" Value="#244D74" />
            </Style>
          </ListBox.Styles>
        </ListBox>
      </Border>
    </Popup>
  </Grid>
</UserControl>
