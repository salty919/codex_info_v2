<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodexInfo.WindowsClient.ViewModels"
        xmlns:core="using:CodexInfo.WindowsClient.Core"
        x:Class="CodexInfo.WindowsClient.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Width="900" Height="480" MinWidth="900" MinHeight="480" MaxWidth="900" MaxHeight="480"
        WindowStartupLocation="CenterOwner" CanResize="False"
        WindowDecorations="None" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="0"
        Title="Codex Info Settings" FontFamily="{StaticResource JapaneseFont}"
        Background="{DynamicResource Theme0E141E}" Foreground="{DynamicResource ThemeE9EFF8}">
  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeA8B7CA}" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeE9EFF8}" />
    </Style>
    <Style Selector="Border.surface">
      <Setter Property="Background" Value="{DynamicResource Theme151F2D}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme2C4258}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Theme236B9E}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme61B4EB}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeF5FAFF}" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource Theme1B2A3A}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme36516B}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeE9EFF8}" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="ToggleButton.account-selector">
      <Setter Property="Background" Value="{DynamicResource Theme18283A}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme304A63}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeEAF2FB}" />
      <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style Selector="ToggleButton.account-selector:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme24415E}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme5EA7E5}" />
    </Style>
    <Style Selector="TabItem.settings-tab">
      <Setter Property="Width" Value="176" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeA8B7CA}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HeaderTemplate">
        <DataTemplate>
          <TextBlock Text="{Binding}" FontSize="14" TextWrapping="Wrap" />
        </DataTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Border x:Name="FocusOutline"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="2"
                    CornerRadius="8"
                    IsHitTestVisible="False" />
            <Border x:Name="PART_Border"
                    Margin="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <Grid ColumnDefinitions="3,*">
                <Border x:Name="SelectionIndicator"
                        CornerRadius="6,0,0,6"
                        Background="Transparent" />
                <ContentPresenter Grid.Column="1"
                                  Padding="{TemplateBinding Padding}"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Grid>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabItem.settings-tab:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource Theme1B2A3A}" />
    </Style>
    <Style Selector="TabItem.settings-tab:selected">
      <Setter Property="Foreground" Value="{DynamicResource ThemeE9EFF8}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabItem.settings-tab:selected /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource Theme18283A}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme304A63}" />
    </Style>
    <Style Selector="TabItem.settings-tab:selected /template/ Border#SelectionIndicator">
      <Setter Property="Background" Value="{DynamicResource Theme56B2F5}" />
    </Style>
    <Style Selector="TabItem.settings-tab:focus-visible /template/ Border#FocusOutline">
      <Setter Property="BorderBrush" Value="{DynamicResource Theme5EA7E5}" />
    </Style>
  </Window.Styles>
  <Grid Margin="24" RowDefinitions="Auto,44,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" Background="Transparent" PointerPressed="OnTitlePointerPressed">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock FontSize="20" Text="⚙" Foreground="{DynamicResource Theme71C7FF}" />
        <StackPanel>
          <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Texts.Settings}" />
          <TextBlock Classes="label" Text="{Binding Texts.ConnectionEndpoint}" />
        </StackPanel>
      </StackPanel>
      <Button Grid.Column="1"
              Background="Transparent"
              BorderBrush="Transparent"
              Foreground="{DynamicResource ThemeA8B7CA}"
              Click="OnClose"
              AutomationProperties.Name="{Binding Texts.Close}"
              AutomationProperties.AutomationId="Settings.Window.Close"
              Content="×"
              FontSize="22"
              ToolTip.Tip="{Binding Texts.Close}" />
    </Grid>
    <ToggleButton Grid.Row="1"
                  Classes="account-selector"
                  x:Name="AccountSelector"
                  Width="250"
                  Height="44"
                  HorizontalAlignment="Left"
                  HorizontalContentAlignment="Stretch"
                  ClickMode="Press"
                  IsCheckedChanged="OnAccountSelectorCheckedChanged"
                  IsVisible="{Binding HasAccounts}"
                  AutomationProperties.Name="{Binding Texts.Account}"
                  AutomationProperties.AutomationId="Settings.AccountSelector"
                  AutomationProperties.HelpText="{Binding SelectedAccountText}"
                  ToolTip.Tip="{Binding SelectedAccountText}">
      <Grid ColumnDefinitions="18,*,14" ColumnSpacing="0">
        <TextBlock Width="14"
                   Foreground="{DynamicResource Theme5DC98A}"
                   Text="●"
                   IsVisible="{Binding SelectedAccount.IsCurrent}"
                   VerticalAlignment="Center"
                   AutomationProperties.AutomationId="Settings.SelectedAccountCurrentMarker" />
        <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
          <TextBlock FontSize="9" Foreground="{DynamicResource Theme56B2F5}" Text="{Binding Texts.Account}" />
          <TextBlock FontSize="11"
                     FontWeight="SemiBold"
                     Text="{Binding SelectedAccountText}"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="NoWrap" />
        </StackPanel>
        <TextBlock Grid.Column="2"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Theme9FB0C5}"
                   Text="⌄" />
      </Grid>
    </ToggleButton>
    <Grid Grid.Row="2" RowDefinitions="*,Auto" RowSpacing="8">
      <TabControl Grid.Row="0" Classes="settings-tabs" TabStripPlacement="Left">
        <TabItem Classes="settings-tab"
                 Header="{Binding Texts.Language}"
                 AutomationProperties.Name="{Binding Texts.Language}"
                 AutomationProperties.AutomationId="Settings.Tab.Language">
          <Border Classes="surface" Padding="16" VerticalAlignment="Top">
            <Grid ColumnDefinitions="144,12,*">
              <TextBlock Classes="field-label" Text="{Binding Texts.Language}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="2"
                        Height="36"
                        ItemsSource="{Binding LanguageOptions}"
                        SelectedValue="{Binding SelectedLanguageCode}"
                        SelectedValueBinding="{Binding LanguageCode}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="Settings.LanguageSelector">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding LanguageName}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>
        </TabItem>
        <TabItem Classes="settings-tab"
                 Header="{Binding Texts.TimeZone}"
                 AutomationProperties.Name="{Binding Texts.TimeZone}"
                 AutomationProperties.AutomationId="Settings.Tab.TimeZone">
          <Border Classes="surface" Padding="16" VerticalAlignment="Top">
            <Grid ColumnDefinitions="144,12,*">
              <TextBlock Classes="field-label" Text="{Binding Texts.TimeZone}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="2"
                        Height="36"
                        ItemsSource="{Binding TimeZoneOptions}"
                        SelectedValue="{Binding SelectedTimeZoneId}"
                        SelectedValueBinding="{Binding Id}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{Binding Texts.TimeZone}"
                        AutomationProperties.AutomationId="Settings.TimeZoneSelector"
                        ToolTip.Tip="{Binding Texts.TimeZone}">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>
        </TabItem>
        <TabItem Classes="settings-tab"
                 Header="{Binding Texts.Appearance}"
                 AutomationProperties.Name="{Binding Texts.Appearance}"
                 AutomationProperties.AutomationId="Settings.Tab.Appearance">
          <Border Classes="surface" Padding="16" VerticalAlignment="Top">
            <Grid ColumnDefinitions="144,12,*" RowDefinitions="36,Auto" RowSpacing="14">
              <TextBlock Classes="field-label" Text="{Binding Texts.Appearance}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="2"
                        Height="36"
                        ItemsSource="{Binding ThemeOptions}"
                        SelectedValue="{Binding SelectedThemeId}"
                        SelectedValueBinding="{Binding Id}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{Binding Texts.Appearance}"
                        AutomationProperties.AutomationId="Settings.ThemeSelector"
                        ToolTip.Tip="{Binding Texts.Appearance}">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource Theme101925}" CornerRadius="6" Padding="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <TextBlock Text="✦" Foreground="{DynamicResource Theme71C7FF}" />
                  <TextBlock Grid.Column="1"
                             Classes="label"
                             Text="{Binding Texts.AppearanceDescription}"
                             TextWrapping="Wrap" />
                </Grid>
              </Border>
            </Grid>
          </Border>
        </TabItem>
        <TabItem Classes="settings-tab"
                 Header="{Binding Texts.SettingsConnectionStatus}"
                 AutomationProperties.Name="{Binding Texts.SettingsConnectionStatus}"
                 AutomationProperties.AutomationId="Settings.Tab.ConnectionStatus">
          <Border Classes="surface" Padding="16" VerticalAlignment="Top">
            <Grid RowDefinitions="Auto,1,Auto" RowSpacing="12">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                  <TextBlock FontSize="16"
                             FontWeight="SemiBold"
                             Text="{Binding StatusTitle}"
                             AutomationProperties.AutomationId="Settings.ConnectionStatus.Title" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="secondary"
                        Click="OnRefresh"
                        AutomationProperties.Name="{Binding Texts.AuthCheck}"
                        AutomationProperties.AutomationId="Settings.AuthCheck"
                        ToolTip.Tip="{Binding Texts.AuthCheck}"
                        Content="{Binding Texts.AuthCheck}" />
                <Button Grid.Column="2"
                        Classes="secondary"
                        Click="OnAuth"
                        IsVisible="{Binding CanAuthenticate}"
                        AutomationProperties.Name="{Binding Texts.AuthStart}"
                        ToolTip.Tip="{Binding Texts.AuthStart}"
                        Content="{Binding Texts.AuthStart}" />
              </Grid>
              <Border Grid.Row="1" Height="1" Background="{DynamicResource Theme2C4258}" />
              <StackPanel Grid.Row="2" Spacing="8">
                <Grid ColumnDefinitions="144,12,*">
                  <TextBlock Classes="label" Text="Recorder" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding RecorderVersion}" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="144,12,*">
                  <TextBlock Classes="label" Text="REST" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding RestVersion}" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Classes="label" Text="{Binding RuntimeVersionStatus}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
        </TabItem>
      </TabControl>
      <Border Grid.Row="1"
              Background="{DynamicResource Theme101F2D}"
              CornerRadius="6"
              Padding="10"
              IsVisible="{Binding SaveFailed}">
        <TextBlock Classes="label"
                   Text="{Binding StatusDetail}"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="Settings.SaveError" />
      </Border>
    </Grid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Classes="secondary"
              Click="OnOpenSetup"
              AutomationProperties.Name="{Binding Texts.ConnectionSettings}"
              AutomationProperties.AutomationId="Settings.Footer.Setup"
              ToolTip.Tip="{Binding Texts.ConnectionSettings}">
        <TextBlock Text="{Binding Texts.ConnectionSettings}" />
      </Button>
      <Button Classes="secondary"
              Click="OnOpenLegal"
              AutomationProperties.Name="{Binding Texts.LicenseInformation}"
              AutomationProperties.AutomationId="Settings.Footer.Legal"
              ToolTip.Tip="{Binding Texts.LicenseInformation}">
        <TextBlock Text="{Binding Texts.LicenseInformation}" />
      </Button>
      <Button Classes="primary"
              Click="OnSave"
              AutomationProperties.Name="{Binding Texts.Save}"
              AutomationProperties.AutomationId="Settings.Footer.Save"
              ToolTip.Tip="{Binding Texts.Save}">
        <TextBlock Text="{Binding Texts.Save}" />
      </Button>
    </StackPanel>
    <!-- Measure the account menu at its final width so opening it does not move the tabs. -->
    <Border x:Name="AccountMenu"
            Grid.Row="1"
            Grid.RowSpan="3"
            ZIndex="100"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="0,44,0,0"
            Opacity="0"
            IsEnabled="False"
            IsHitTestVisible="False"
            Width="560"
            MaxWidth="560"
            MaxHeight="320"
            Padding="4"
            Background="{DynamicResource Theme1B2838}"
            BorderBrush="{DynamicResource Theme47769F}"
            BorderThickness="1"
            CornerRadius="6">
      <ListBox ItemsSource="{Binding Accounts}"
               SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
               SelectionChanged="OnAccountSelectionChanged"
               AutomationProperties.AutomationId="Settings.AccountMenu">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:ApiAccount">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
              <TextBlock Foreground="{DynamicResource Theme5DC98A}"
                         Text="●"
                         IsVisible="{Binding IsCurrent}"
                         VerticalAlignment="Center"
                         AutomationProperties.AutomationId="Settings.AccountCurrentMarker" />
              <TextBlock Grid.Column="1"
                         Text="{Binding MainDisplayLabel}"
                         TextWrapping="Wrap"
                         ToolTip.Tip="{Binding MainDisplayLabel}"
                         AutomationProperties.Name="{Binding MainDisplayLabel}"
                         AutomationProperties.HelpText="{Binding MainDisplayLabel}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</Window>
