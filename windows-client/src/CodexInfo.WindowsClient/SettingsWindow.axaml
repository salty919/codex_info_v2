<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodexInfo.WindowsClient.ViewModels"
        xmlns:core="using:CodexInfo.WindowsClient.Core"
        x:Class="CodexInfo.WindowsClient.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Width="900" Height="480" MinWidth="900" MinHeight="480" MaxWidth="900" MaxHeight="480"
        WindowStartupLocation="CenterOwner" CanResize="False"
        WindowDecorations="None" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="0"
        Title="Codex Info Settings" FontFamily="{StaticResource JapaneseFont}"
        Background="{DynamicResource Theme0E141E}" Foreground="{DynamicResource ThemeE9EFF8}">
  <Window.Styles>
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{DynamicResource ThemeA8B7CA}" /></Style>
    <Style Selector="Border.surface"><Setter Property="Background" Value="{DynamicResource Theme151F2D}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme2C4258}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource Theme236B9E}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme61B4EB}" /><Setter Property="Foreground" Value="{DynamicResource ThemeF5FAFF}" /><Setter Property="Padding" Value="16,8" /></Style>
    <Style Selector="Button.secondary"><Setter Property="Background" Value="{DynamicResource Theme1B2A3A}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme36516B}" /><Setter Property="Foreground" Value="{DynamicResource ThemeE9EFF8}" /><Setter Property="Padding" Value="16,8" /></Style>
    <Style Selector="ToggleButton.account-selector">
      <Setter Property="Background" Value="{DynamicResource Theme18283A}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme304A63}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeEAF2FB}" />
      <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style Selector="ToggleButton.account-selector:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme24415E}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme5EA7E5}" />
    </Style>
  </Window.Styles>
  <Grid Margin="24" RowDefinitions="Auto,44,*,Auto" RowSpacing="18">
    <Grid ColumnDefinitions="*,Auto" Background="Transparent" PointerPressed="OnTitlePointerPressed">
      <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock FontSize="20" Text="⚙" Foreground="{DynamicResource Theme71C7FF}" /><StackPanel><TextBlock FontSize="23" FontWeight="SemiBold" Text="{Binding Texts.Settings}" /><TextBlock Classes="label" Text="{Binding Texts.ConnectionEndpoint}" /></StackPanel></StackPanel>
      <Button Grid.Column="1" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource ThemeA8B7CA}" Click="OnClose" AutomationProperties.Name="{Binding Texts.Close}" AutomationProperties.AutomationId="Settings.Window.Close" Content="×" FontSize="22" ToolTip.Tip="{Binding Texts.Close}" />
    </Grid>
      <ToggleButton Grid.Row="1"
                    Classes="account-selector"
                    x:Name="AccountSelector"
                    Width="250"
                    Height="44"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Stretch"
                    ClickMode="Press"
                    IsCheckedChanged="OnAccountSelectorCheckedChanged"
                    IsVisible="{Binding HasAccounts}"
                    AutomationProperties.Name="{Binding Texts.Account}"
                    AutomationProperties.AutomationId="Settings.AccountSelector"
                    AutomationProperties.HelpText="{Binding SelectedAccountText}"
                    ToolTip.Tip="{Binding SelectedAccountText}">
        <Grid ColumnDefinitions="18,*,14" ColumnSpacing="0">
          <TextBlock Width="14"
                     Foreground="{DynamicResource Theme5DC98A}"
                     Text="●"
                     IsVisible="{Binding SelectedAccount.IsCurrent}"
                     VerticalAlignment="Center"
                     AutomationProperties.AutomationId="Settings.SelectedAccountCurrentMarker" />
          <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
            <TextBlock FontSize="9"
                       Foreground="{DynamicResource Theme56B2F5}"
                       Text="{Binding Texts.Account}" />
            <TextBlock FontSize="11"
                       FontWeight="SemiBold"
                       Text="{Binding SelectedAccountText}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
          </StackPanel>
          <TextBlock Grid.Column="2"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Theme9FB0C5}"
                     Text="⌄" />
        </Grid>
      </ToggleButton>
    <TabControl Grid.Row="2">
      <TabItem Header="{Binding Texts.Language}"
               AutomationProperties.Name="{Binding Texts.Language}"
               AutomationProperties.AutomationId="Settings.Tab.Language">
        <Border Classes="surface" Padding="18">
          <StackPanel Spacing="14">
            <ComboBox ItemsSource="{Binding LanguageOptions}"
                      SelectedValue="{Binding SelectedLanguageCode}"
                      SelectedValueBinding="{Binding LanguageCode}"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.AutomationId="Settings.LanguageSelector">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding LanguageName}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Border>
      </TabItem>
      <TabItem Header="{Binding Texts.TimeZone}"
               AutomationProperties.Name="{Binding Texts.TimeZone}"
               AutomationProperties.AutomationId="Settings.Tab.TimeZone">
        <Border Classes="surface" Padding="18">
          <StackPanel Spacing="14">
            <ComboBox ItemsSource="{Binding TimeZoneOptions}"
                      SelectedValue="{Binding SelectedTimeZoneId}"
                      SelectedValueBinding="{Binding Id}"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{Binding Texts.TimeZone}"
                      AutomationProperties.AutomationId="Settings.TimeZoneSelector"
                      ToolTip.Tip="{Binding Texts.TimeZone}">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Border>
      </TabItem>
      <TabItem Header="{Binding Texts.Appearance}"
               AutomationProperties.Name="{Binding Texts.Appearance}"
               AutomationProperties.AutomationId="Settings.Tab.Appearance">
        <Border Classes="surface" Padding="18">
          <StackPanel Spacing="14">
            <TextBlock Classes="label" Text="{Binding Texts.Appearance}" />
            <ComboBox ItemsSource="{Binding ThemeOptions}"
                      SelectedValue="{Binding SelectedThemeId}"
                      SelectedValueBinding="{Binding Id}"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{Binding Texts.Appearance}"
                      AutomationProperties.AutomationId="Settings.ThemeSelector"
                      ToolTip.Tip="{Binding Texts.Appearance}">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Border Background="{DynamicResource Theme101925}" CornerRadius="10" Padding="14">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Text="✦" Foreground="{DynamicResource Theme71C7FF}" />
                <TextBlock Grid.Column="1"
                           Classes="label"
                           Text="{Binding Texts.AppearanceDescription}"
                           TextWrapping="Wrap" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </TabItem>
      <TabItem Header="{Binding Texts.SettingsConnectionStatus}"
               AutomationProperties.Name="{Binding Texts.SettingsConnectionStatus}"
               AutomationProperties.AutomationId="Settings.Tab.ConnectionStatus">
        <Border Classes="surface" Padding="18">
          <StackPanel Spacing="14">
            <Border Background="{DynamicResource Theme101F2D}" CornerRadius="10" Padding="14">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="12">
                <StackPanel>
                  <TextBlock FontWeight="SemiBold" Text="{Binding StatusTitle}" />
                  <TextBlock Grid.Row="1" Classes="label" Text="{Binding StatusDetail}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Classes="secondary"
                          Click="OnRefresh"
                          AutomationProperties.Name="{Binding Texts.AuthCheck}"
                          AutomationProperties.AutomationId="Settings.AuthCheck"
                          ToolTip.Tip="{Binding Texts.AuthCheck}"
                          Content="{Binding Texts.AuthCheck}" />
                  <Button Classes="secondary"
                          Click="OnAuth"
                          IsVisible="{Binding CanAuthenticate}"
                          AutomationProperties.Name="{Binding Texts.AuthStart}"
                          ToolTip.Tip="{Binding Texts.AuthStart}"
                          Content="{Binding Texts.AuthStart}" />
                </StackPanel>
              </Grid>
            </Border>
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="100,*">
                <TextBlock Classes="label" Text="Recorder" />
                <TextBlock Grid.Column="1" Text="{Binding RecorderVersion}" />
              </Grid>
              <Grid ColumnDefinitions="100,*">
                <TextBlock Classes="label" Text="REST" />
                <TextBlock Grid.Column="1" Text="{Binding RestVersion}" />
              </Grid>
              <TextBlock Classes="label" Text="{Binding RuntimeVersionStatus}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Classes="secondary" Click="OnOpenSetup" AutomationProperties.Name="{Binding Texts.Setup}" AutomationProperties.AutomationId="Settings.Footer.Setup" ToolTip.Tip="{Binding Texts.Setup}"><TextBlock Text="{Binding Texts.Setup}" /></Button>
      <Button Classes="secondary" Click="OnOpenLegal" AutomationProperties.Name="{Binding Texts.Legal}" AutomationProperties.AutomationId="Settings.Footer.Legal" ToolTip.Tip="{Binding Texts.Legal}"><TextBlock Text="{Binding Texts.Legal}" /></Button>
      <Button Classes="primary" Click="OnSave" AutomationProperties.Name="{Binding Texts.Save}" AutomationProperties.AutomationId="Settings.Footer.Save" ToolTip.Tip="{Binding Texts.Save}"><TextBlock Text="{Binding Texts.Save}" /></Button>
    </StackPanel>
    <!-- The account list is measured at its final width before it is opened,
         so opening the list does not move the other settings. -->
    <Border x:Name="AccountMenu"
            Grid.Row="1"
            Grid.RowSpan="3"
            ZIndex="100"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="0,44,0,0"
            Opacity="0"
            IsEnabled="False"
            IsHitTestVisible="False"
            Width="560"
            MaxWidth="560"
            MaxHeight="320"
            Padding="4"
            Background="{DynamicResource Theme1B2838}"
            BorderBrush="{DynamicResource Theme47769F}"
            BorderThickness="1"
            CornerRadius="6">
      <ListBox ItemsSource="{Binding Accounts}"
               SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
               SelectionChanged="OnAccountSelectionChanged"
               AutomationProperties.AutomationId="Settings.AccountMenu">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:ApiAccount">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
              <TextBlock Foreground="{DynamicResource Theme5DC98A}"
                         Text="●"
                         IsVisible="{Binding IsCurrent}"
                         VerticalAlignment="Center"
                         AutomationProperties.AutomationId="Settings.AccountCurrentMarker" />
              <TextBlock Grid.Column="1"
                         Text="{Binding MainDisplayLabel}"
                         TextWrapping="Wrap"
                         ToolTip.Tip="{Binding MainDisplayLabel}"
                         AutomationProperties.Name="{Binding MainDisplayLabel}"
                         AutomationProperties.HelpText="{Binding MainDisplayLabel}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</Window>
