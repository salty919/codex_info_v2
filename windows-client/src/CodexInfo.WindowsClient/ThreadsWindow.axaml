<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodexInfo.WindowsClient.ViewModels"
        xmlns:tree="using:CodexInfo.WindowsClient.Controls"
        x:Class="CodexInfo.WindowsClient.ThreadsWindow"
        x:DataType="vm:ThreadsWindowViewModel"
        Width="900"
        Height="480"
        MinWidth="900"
        MinHeight="480"
        MaxWidth="900"
        MaxHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Title="Codex Info Threads"
        FontFamily="{StaticResource JapaneseFont}"
        Background="#0E141E"
        Foreground="#E9EFF8">
  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#A8B7CA" />
    </Style>
    <Style Selector="Border.thread-card">
      <Setter Property="Background" Value="#151F2D" />
      <Setter Property="BorderBrush" Value="#2B425B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Height" Value="84" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Border.thread-root-marker">
      <Setter Property="Background" Value="#94A3B8" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Width" Value="3" />
      <Setter Property="Margin" Value="-14,8,0,8" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.model-accent">
      <Setter Property="Width" Value="2" />
      <Setter Property="Height" Value="12" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#A8B7CA" />
    </Style>
    <Style Selector="Button.window-control:pointerover">
      <Setter Property="Background" Value="#263548" />
      <Setter Property="Foreground" Value="#F2F6FC" />
    </Style>
  </Window.Styles>
  <Grid Margin="20" RowDefinitions="30,14,384" RowSpacing="6">
    <Grid ColumnDefinitions="*,Auto" Background="Transparent" PointerPressed="OnTitlePointerPressed">
      <StackPanel VerticalAlignment="Center"><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Texts.RunningThreads}" /></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
        <Button Classes="window-control" Click="OnMinimizeWindow" AutomationProperties.Name="{Binding Texts.Minimize}" AutomationProperties.AutomationId="Threads.Window.Minimize" Content="—" ToolTip.Tip="{Binding Texts.Minimize}" />
        <Button Classes="window-control" Click="OnCloseWindow" AutomationProperties.Name="{Binding Texts.Close}" AutomationProperties.AutomationId="Threads.Window.Close" Content="×" ToolTip.Tip="{Binding Texts.Close}" />
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="1" Classes="label" Text="{Binding DetailsStatusText}" />
    <ScrollViewer Grid.Row="2"
                  Height="384"
                  VerticalAlignment="Top"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid Width="860" Height="{Binding TreeSurfaceHeight}">
        <TextBlock Classes="label" HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="{Binding HasNoThreads}" Text="{Binding EmptyText}" />
        <tree:ThreadTreeControl Width="860"
                                Height="{Binding TreeSurfaceHeight}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                Connections="{Binding TreeConnections}" />
        <ItemsControl Width="860" IsVisible="{Binding HasThreads}" ItemsSource="{Binding Threads}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ThreadItemViewModel">
              <Grid Height="96">
                <Border Classes="thread-card"
                        Margin="80,6,16,6"
                        AutomationProperties.Name="{Binding Title}">
                  <Grid Margin="0"
                        ColumnDefinitions="*,180,208"
                        ColumnSpacing="12">
                    <Border Classes="thread-root-marker"
                            IsVisible="{Binding IsRootThread}"
                            AutomationProperties.Name="{Binding Title}" />
                    <TextBlock Grid.Column="0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="{Binding Id}"
                               AutomationProperties.Name="{Binding Title}"
                               Text="{Binding Title}"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               AutomationProperties.HelpText="{Binding Title}"
                               ToolTip.Tip="{Binding Title}" />
                    <Grid Grid.Column="1"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="4"
                          VerticalAlignment="Center">
                      <Border Grid.Row="0"
                              Classes="model-accent"
                              Background="{Binding ModelAccentHex}" />
                      <TextBlock Grid.Row="0"
                                 Margin="8,0,0,0"
                                 Classes="label"
                                 FontWeight="SemiBold"
                                 Foreground="{Binding ModelAccentHex}"
                                 Text="{Binding ModelText}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1"
                                 Classes="label"
                                 IsVisible="{Binding HasContextUsage}"
                                 Text="{Binding ContextUsageText}"
                                 TextWrapping="Wrap"
                                 MaxLines="2"
                                 AutomationProperties.Name="{Binding ContextUsageText}"
                                 ToolTip.Tip="{Binding ContextUsageText}" />
                    </Grid>
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="label"
                                 HorizontalAlignment="Right"
                                 IsVisible="{Binding HasElapsedMinutes}"
                                 Text="{Binding ElapsedMinutesText}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="label"
                                 HorizontalAlignment="Right"
                                 IsVisible="{Binding HasInstructionMinutes}"
                                 Text="{Binding InstructionMinutesText}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="label"
                                 HorizontalAlignment="Right"
                                 IsVisible="{Binding HasDisplayToken}"
                                 Text="{Binding DisplayTokenText}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
