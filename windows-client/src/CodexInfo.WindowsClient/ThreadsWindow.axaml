<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodexInfo.WindowsClient.ViewModels"
        xmlns:tree="using:CodexInfo.WindowsClient.Controls"
        x:Class="CodexInfo.WindowsClient.ThreadsWindow"
        x:DataType="vm:ThreadsWindowViewModel"
        Width="900"
        Height="480"
        MinWidth="900"
        MinHeight="480"
        MaxWidth="900"
        MaxHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Title="Codex Info Threads"
        FontFamily="{StaticResource JapaneseFont}"
        Background="{DynamicResource Theme0E141E}"
        Foreground="{DynamicResource ThemeE9EFF8}">
  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeA8B7CA}" />
    </Style>
    <Style Selector="Border.thread-card">
      <Setter Property="Background" Value="{DynamicResource Theme151F2D}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme2B425B}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Height" Value="84" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Border.model-accent">
      <Setter Property="Width" Value="2" />
      <Setter Property="Height" Value="12" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
  </Window.Styles>
  <Grid Margin="20" RowDefinitions="30,384" RowSpacing="6">
    <Grid ColumnDefinitions="*,Auto" Background="Transparent" PointerPressed="OnTitlePointerPressed">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <PathIcon Classes="heading-icon" Data="{StaticResource IconThreads}" />
        <TextBlock Classes="window-title" Text="{Binding Texts.RunningThreads}" />
        <TextBlock Classes="label" Margin="12,0,0,0" MaxWidth="420" VerticalAlignment="Center"
                   Text="{Binding LoadErrorText}" TextWrapping="Wrap"
                   Foreground="{DynamicResource ThemeF0A35B}" IsVisible="{Binding HasLoadError}"
                   AutomationProperties.AutomationId="Threads.LoadError" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
        <Button Classes="window-control" Click="OnMinimizeWindow" AutomationProperties.Name="{Binding Texts.Minimize}" AutomationProperties.AutomationId="Threads.Window.Minimize" Content="—" ToolTip.Tip="{Binding Texts.Minimize}" />
        <Button Classes="window-control" Click="OnCloseWindow" AutomationProperties.Name="{Binding Texts.Close}" AutomationProperties.AutomationId="Threads.Window.Close" Content="×" ToolTip.Tip="{Binding Texts.Close}" />
      </StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1"
                  Height="384"
                  VerticalAlignment="Top"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid Width="860" Height="{Binding TreeSurfaceHeight}" VerticalAlignment="Top">
        <TextBlock Classes="label" HorizontalAlignment="Center" VerticalAlignment="Top"
                   IsVisible="{Binding HasPendingThreads}" Text="{Binding Texts.UnavailableDetails}"
                   AutomationProperties.AutomationId="Threads.Pending" />
        <TextBlock Classes="label" HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="{Binding HasNoThreads}" Text="{Binding EmptyText}" />
        <ItemsControl Width="860" IsVisible="{Binding HasThreads}" ItemsSource="{Binding Threads}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ThreadItemViewModel">
              <Grid Height="96">
                <Border Classes="thread-card"
                        Margin="80,6,16,6"
                        Background="{Binding CardBackgroundHex}"
                        AutomationProperties.Name="{Binding Title}">
                  <Grid Margin="0"
                        ColumnDefinitions="*,180,208"
                        ColumnSpacing="12">
                    <TextBlock Grid.Column="0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Top"
                               AutomationProperties.AutomationId="{Binding Id}"
                               AutomationProperties.Name="{Binding Title}"
                               Text="{Binding Title}"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               AutomationProperties.HelpText="{Binding Title}"
                               ToolTip.Tip="{Binding Title}" />
                    <Grid Grid.Column="1"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="4"
                          VerticalAlignment="Top">
                      <Border Grid.Row="0"
                              Classes="model-accent"
                              Background="{Binding ModelAccentHex}" />
                      <TextBlock Grid.Row="0"
                                 Margin="8,0,0,0"
                                 Classes="label"
                                 FontWeight="SemiBold"
                                 Foreground="{Binding ModelAccentHex}"
                                 Text="{Binding ModelText}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1"
                                 Classes="label"
                                 Text="{Binding ContextUsageText}"
                                 TextWrapping="Wrap"
                                 MaxLines="2"
                                 AutomationProperties.Name="{Binding ContextUsageText}"
                                 ToolTip.Tip="{Binding ContextUsageText}" />
                    </Grid>
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Top">
                      <TextBlock Classes="label"
                                 HorizontalAlignment="Right"
                                 Text="{Binding ActivityStatusText}"
                                 Foreground="{Binding ActivityStatusHex}"
                                 AutomationProperties.Name="{Binding ActivityStatusText}" />
                      <TextBlock Classes="label"
                                 HorizontalAlignment="Right"
                                 IsVisible="{Binding HasElapsedMinutes}"
                                 Text="{Binding ElapsedMinutesText}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="label"
                                 HorizontalAlignment="Right"
                                 IsVisible="{Binding HasInstructionMinutes}"
                                 Text="{Binding InstructionMinutesText}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="label"
                                 HorizontalAlignment="Right"
                                 IsVisible="{Binding HasDisplayToken}"
                                 Text="{Binding DisplayTokenText}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <tree:ThreadTreeControl Width="860"
                                Height="{Binding TreeSurfaceHeight}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                ZIndex="1"
                                IsHitTestVisible="False"
                                IsVisible="{Binding HasThreads}"
                                Connections="{Binding TreeConnections}"
                                RootRows="{Binding TreeRootRows}" />
      </Grid>
    </ScrollViewer>
  <Border Classes="window-frame" Classes.active="{Binding $parent[Window].IsActive}"
            Grid.RowSpan="2" Margin="-20" IsHitTestVisible="False" />
  </Grid>
</Window>
