import { UiStrings, Header, WindowDragArea, RemainingQuota, WeekGauge, AccountActivity, ModelUsage, StatusBanner, AuthPanel, GraphWindow, ThreadsWindow, LegalNoticeWindow } from "components.slint";
import { DesignTokens } from "theme.slint";
import "../assets/NotoSansJP.ttf";
import "../assets/NotoSansKR.otf";

export { GraphWindow, ThreadsWindow, LegalNoticeWindow, UiStrings }

export component MainWindow inherits Window {
    preferred-width: 900px;
    preferred-height: 480px;
    min-width: 900px;
    max-width: 900px;
    min-height: 480px;
    max-height: 480px;
    in-out property <string> window-title;
    in-out property <UiStrings> strings;
    // The application owns the title controls so the native frame never
    // reintroduces a platform-specific maximize/resize affordance.
    no-frame: true;
    resize-border-width: 0px;
    title: root.window-title;
    background: DesignTokens.canvas;
    default-font-family: root.strings.font-family;

    changed maximized => {
        if (self.maximized) {
            self.maximized = false;
        }
    }
    changed full-screen => {
        if (self.full-screen) {
            self.full-screen = false;
        }
    }

    in-out property <bool> authenticated: false;
    in-out property <bool> has-usage: false;
    in-out property <bool> has-auth-url: false;
    in-out property <bool> checking: true;
    in-out property <bool> has-error: false;
    in-out property <bool> service-unavailable: false;
    in-out property <bool> startup-loading: false;
    in-out property <string> quota-title;
    in-out property <bool> has-quota-percent: true;
    in-out property <bool> has-active-thread: false;
    in-out property <int> active-thread-count: 0;
    in-out property <string> active-thread-count-label;
    in-out property <int> active-thread-sol-count: 0;
    in-out property <int> active-thread-terra-count: 0;
    in-out property <int> active-thread-luna-count: 0;
    in-out property <int> active-thread-astra-count: 0;
    in-out property <int> active-thread-other-count: 0;
    in-out property <string> estimated-cost-label;
    in-out property <string> remaining-label: "—";
    in-out property <string> week-label;
    in-out property <string> model-usage-names;
    in-out property <string> model-usage-input-tokens;
    in-out property <string> model-usage-input-costs;
    in-out property <string> model-usage-cached-tokens;
    in-out property <string> model-usage-cached-costs;
    in-out property <string> model-usage-output-tokens;
    in-out property <string> model-usage-output-costs;
    in-out property <string> model-usage-period;
    in-out property <bool> has-model-usage: false;
    in-out property <string> status;
    in-out property <string> status-level: "info";
    in-out property <float> remaining-percent: 0;
    in-out property <float> remaining-days: 0;
    private property <length> content-width: root.width > 800px ? DesignTokens.content-max-width : root.width - 2 * DesignTokens.outer-margin-compact;
    callback begin-auth();
    callback check-auth();
    callback retry();
    callback open-graph();
    callback open-threads();
    callback open-legal-notice();
    callback begin-window-drag();
    callback minimize-window();
    callback close-window();

    // Frameless windows do not receive a compositor-painted frame. Paint the
    // entire client surface so margins never reveal another window beneath it.
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: DesignTokens.canvas;
        z: -10;
    }
    if root.status-level == "warning" : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: DesignTokens.canvas-warning;
        z: -9;
    }
    if root.status-level == "error" : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: DesignTokens.canvas-error;
        z: -9;
    }
    WindowDragArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        z: -5;
        begin-drag => { root.begin-window-drag(); }
    }

    Rectangle {
        x: root.width > 800px ? (root.width - DesignTokens.content-max-width) / 2 : DesignTokens.outer-margin-compact;
        y: DesignTokens.outer-margin-compact;
        width: root.content-width;
        height: root.height - self.y - DesignTokens.outer-margin-compact;

        if root.authenticated : VerticalLayout {
            x: 0px;
            y: 0px;
            width: root.content-width;
            height: parent.height;
            spacing: DesignTokens.space-2;
            alignment: start;
            Header {
                strings: root.strings;
                width: root.content-width;
                preferred-width: root.content-width;
                horizontal-stretch: 1;
                period-label: root.model-usage-period;
                show-graph: true;
                open-graph => { root.open-graph(); }
                open-legal-notice => { root.open-legal-notice(); }
                begin-window-drag => { root.begin-window-drag(); }
                minimize-window => { root.minimize-window(); }
                close-window => { root.close-window(); }
            }
            if root.has-usage : RemainingQuota {
                width: root.content-width;
                preferred-width: root.content-width;
                horizontal-stretch: 1;
                quota-title: root.quota-title;
                remaining-label: root.remaining-label;
                remaining-percent: root.remaining-percent;
                has-quota-percent: root.has-quota-percent;
                estimated-cost-label: root.estimated-cost-label;
            }
            if root.has-usage && root.has-quota-percent : WeekGauge {
                width: root.content-width;
                preferred-width: root.content-width;
                horizontal-stretch: 1;
                remaining-days: root.remaining-days;
                remaining-label: root.week-label;
            }
            AccountActivity {
                strings: root.strings;
                active-thread-count-label: root.active-thread-count-label;
                width: root.content-width;
                preferred-width: root.content-width;
                horizontal-stretch: 1;
                has-active-thread: root.has-active-thread;
                active-thread-count: root.active-thread-count;
                sol-count: root.active-thread-sol-count;
                terra-count: root.active-thread-terra-count;
                luna-count: root.active-thread-luna-count;
                astra-count: root.active-thread-astra-count;
                other-count: root.active-thread-other-count;
                open-threads => { root.open-threads(); }
            }
            if root.has-model-usage : ModelUsage {
                strings: root.strings;
                width: root.content-width;
                preferred-width: root.content-width;
                horizontal-stretch: 1;
                model-names: root.model-usage-names;
                input-token-rows: root.model-usage-input-tokens;
                input-cost-rows: root.model-usage-input-costs;
                cached-token-rows: root.model-usage-cached-tokens;
                cached-cost-rows: root.model-usage-cached-costs;
                output-token-rows: root.model-usage-output-tokens;
                output-cost-rows: root.model-usage-output-costs;
            }
            StatusBanner {
                strings: root.strings;
                width: root.content-width;
                preferred-width: root.content-width;
                horizontal-stretch: 1;
                message: root.status;
                level: root.status-level;
                show-retry: root.has-error;
                retry => { root.retry(); }
            }
        }
        if root.authenticated && root.startup-loading : Rectangle {
            x: 0px;
            y: 48px;
            width: parent.width;
            height: parent.height - 48px;
            background: DesignTokens.canvas;
            z: 5;
            Text {
                x: 0px;
                y: parent.height / 2 - 24px;
                width: parent.width;
                height: 28px;
                text: "◌  " + root.strings.checking;
                color: DesignTokens.text-secondary;
                font-size: DesignTokens.text-body;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if !root.authenticated : VerticalLayout {
            x: 0px;
            y: 0px;
            width: root.content-width;
            height: parent.height;
            spacing: DesignTokens.space-2;
            alignment: start;
            Header {
                strings: root.strings;
                width: root.content-width;
                preferred-width: root.content-width;
                horizontal-stretch: 1;
                period-label: "";
                show-graph: false;
                open-legal-notice => { root.open-legal-notice(); }
                begin-window-drag => { root.begin-window-drag(); }
                minimize-window => { root.minimize-window(); }
                close-window => { root.close-window(); }
            }
            AuthPanel {
                strings: root.strings;
                width: root.content-width;
                preferred-width: root.content-width;
                horizontal-stretch: 1;
                has-auth-url: root.has-auth-url;
                checking: root.checking;
                status: root.status;
                has-error: root.has-error;
                service-unavailable: root.service-unavailable;
                begin-auth => { root.begin-auth(); }
                check-auth => { root.check-auth(); }
                retry => { root.retry(); }
            }
        }
    }
}
