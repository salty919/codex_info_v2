import { UiStrings, MainAccountOption, Header, WindowDragArea, RemainingQuota, WeekGauge, AccountActivity, ModelUsage, StatusBanner, GraphWindow, ThreadsWindow, LegalNoticeWindow, TimeZoneSettingsWindow } from "components.slint";
import { DesignTokens } from "theme.slint";
import "../assets/NotoSansJP.ttf";
import "../assets/NotoSansKR.otf";

export { GraphWindow, ThreadsWindow, LegalNoticeWindow, TimeZoneSettingsWindow, UiStrings, MainAccountOption }

export component MainWindow inherits Window {
    preferred-width: 900px;
    preferred-height: 480px;
    min-width: 900px;
    max-width: 900px;
    min-height: 480px;
    max-height: 480px;
    in-out property <string> window-title;
    in-out property <UiStrings> strings;
    // The application owns the title controls so the native frame never
    // reintroduces a platform-specific maximize/resize affordance.
    no-frame: true;
    resize-border-width: 0px;
    title: root.window-title;
    background: DesignTokens.main-canvas;
    default-font-family: root.strings.font-family;

    changed maximized => {
        if (self.maximized) {
            self.maximized = false;
        }
    }
    changed full-screen => {
        if (self.full-screen) {
            self.full-screen = false;
        }
    }

    in-out property <bool> authenticated: false;
    in-out property <bool> has-usage: false;
    in-out property <bool> has-auth-url: false;
    in-out property <bool> checking: true;
    in-out property <bool> has-error: false;
    in-out property <bool> service-unavailable: false;
    in-out property <bool> startup-loading: false;
    // Historical accounts are immutable final snapshots. They never expose a
    // live reset countdown or current-thread panel.
    in-out property <bool> historical-account: false;
    in-out property <bool> account-view-loading: false;
    in property <[MainAccountOption]> account-options;
    in property <int> selected-account-index: 0;
    in-out property <string> quota-title;
    in-out property <bool> has-quota-percent: true;
    in-out property <bool> has-active-thread: false;
    in-out property <int> active-thread-count: 0;
    in-out property <string> active-thread-count-label;
    in-out property <int> active-thread-sol-count: 0;
    in-out property <int> active-thread-terra-count: 0;
    in-out property <int> active-thread-luna-count: 0;
    in-out property <int> active-thread-astra-count: 0;
    in-out property <int> active-thread-other-count: 0;
    in-out property <string> estimated-cost-label;
    in-out property <string> remaining-label: "—";
    in-out property <string> week-label;
    in-out property <string> reset-label;
    in-out property <string> observed-label;
    in-out property <string> model-usage-names;
    in-out property <string> model-usage-input-tokens;
    in-out property <string> model-usage-input-costs;
    in-out property <string> model-usage-cached-tokens;
    in-out property <string> model-usage-cached-costs;
    in-out property <string> model-usage-output-tokens;
    in-out property <string> model-usage-output-costs;
    in-out property <string> model-usage-period;
    in-out property <bool> has-model-usage: false;
    in-out property <string> status;
    in-out property <string> status-title;
    in-out property <string> status-last-received;
    in-out property <string> status-level: "info";
    in-out property <float> remaining-percent: 0;
    in-out property <float> remaining-days: 0;
    // Main shares the Windows client's fixed 900x480 client geometry. State
    // changes replace content inside these rows and never move a later row.
    private property <length> main-content-x: 22px;
    private property <length> main-content-y: 14px;
    private property <length> main-content-width: 856px;
    private property <length> main-content-height: 452px;
    private property <length> main-header-y: 0px;
    private property <length> main-quota-y: 60px;
    private property <length> main-week-y: 150px;
    private property <length> main-activity-y: 236px;
    private property <length> main-model-y: 300px;
    private property <length> main-status-y: 410px;
    private property <bool> show-data-cards: root.authenticated || root.historical-account || root.account-view-loading;
    callback begin-auth();
    callback check-auth();
    callback retry();
    callback open-graph();
    callback select-account(string);
    callback open-threads();
    callback open-legal-notice();
    callback open-settings();
    callback begin-window-drag();
    callback minimize-window();
    callback close-window();

    // Frameless windows do not receive a compositor-painted frame. Paint the
    // entire client surface so margins never reveal another window beneath it.
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: DesignTokens.main-canvas;
        z: -10;
    }
    WindowDragArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        z: -5;
        begin-drag => { root.begin-window-drag(); }
    }

    Rectangle {
        x: root.main-content-x;
        y: root.main-content-y;
        width: root.main-content-width;
        height: root.main-content-height;

        Rectangle {
            x: 0px;
            y: 0px;
            width: root.main-content-width;
            height: parent.height;
            Header {
                x: 0px;
                y: root.main-header-y;
                strings: root.strings;
                width: root.main-content-width;
                height: 52px;
                show-graph: root.authenticated && !root.account-view-loading;
                account-options: root.account-options;
                selected-account-index: root.selected-account-index;
                open-graph => { root.open-graph(); }
                select-account(value) => { root.select-account(value); }
                open-legal-notice => { root.open-legal-notice(); }
                open-settings => { root.open-settings(); }
                begin-window-drag => { root.begin-window-drag(); }
                minimize-window => { root.minimize-window(); }
                close-window => { root.close-window(); }
            }
            RemainingQuota {
                x: 0px;
                y: root.main-quota-y;
                width: root.main-content-width;
                height: 82px;
                visible: root.show-data-cards;
                quota-title: root.quota-title;
                remaining-label: root.remaining-label;
                remaining-percent: root.remaining-percent;
                has-quota-percent: root.has-usage && root.has-quota-percent;
                estimated-cost-label: root.estimated-cost-label;
            }
            WeekGauge {
                x: 0px;
                y: root.main-week-y;
                width: root.main-content-width;
                height: 78px;
                visible: root.show-data-cards;
                remaining-days: root.remaining-days;
                remaining-label: root.has-usage && root.has-quota-percent && !root.historical-account
                    ? root.week-label : root.strings.no-records;
                reset-label: root.has-usage && root.has-quota-percent && !root.historical-account
                    ? root.reset-label : "";
                observed-label: root.has-usage && root.has-quota-percent && !root.historical-account
                    ? root.observed-label : "";
                show-gauge: root.has-usage && root.has-quota-percent && !root.historical-account;
            }
            AccountActivity {
                x: 0px;
                y: root.main-activity-y;
                strings: root.strings;
                active-thread-count-label: root.active-thread-count-label;
                width: root.main-content-width;
                height: 56px;
                visible: root.show-data-cards;
                show-content: root.authenticated && !root.historical-account && !root.account-view-loading;
                has-active-thread: root.has-active-thread;
                active-thread-count: root.active-thread-count;
                sol-count: root.active-thread-sol-count;
                terra-count: root.active-thread-terra-count;
                luna-count: root.active-thread-luna-count;
                astra-count: root.active-thread-astra-count;
                other-count: root.active-thread-other-count;
                open-threads => { root.open-threads(); }
            }
            ModelUsage {
                x: 0px;
                y: root.main-model-y;
                strings: root.strings;
                width: root.main-content-width;
                height: 102px;
                visible: root.show-data-cards;
                has-data: root.has-model-usage;
                model-names: root.model-usage-names;
                input-token-rows: root.model-usage-input-tokens;
                input-cost-rows: root.model-usage-input-costs;
                cached-token-rows: root.model-usage-cached-tokens;
                cached-cost-rows: root.model-usage-cached-costs;
                output-token-rows: root.model-usage-output-tokens;
                output-cost-rows: root.model-usage-output-costs;
            }
            StatusBanner {
                x: 0px;
                y: root.main-status-y;
                strings: root.strings;
                width: root.main-content-width;
                height: 42px;
                title: root.status-title;
                detail: root.status;
                last-received: root.status-last-received;
                level: root.status-level;
                show-action: !root.authenticated || root.has-error;
                action-text: root.service-unavailable || (root.authenticated && root.has-error)
                    ? root.strings.retry
                    : root.checking
                        ? root.strings.checking
                        : root.has-auth-url ? root.strings.open-auth-page : root.strings.start-auth;
                action-enabled: !root.checking;
                action => {
                    if (root.service-unavailable || root.authenticated) {
                        root.retry();
                    } else {
                        root.begin-auth();
                    }
                }
            }
        }
        if root.startup-loading : Rectangle {
            x: 0px;
            y: root.main-quota-y;
            width: parent.width;
            height: parent.height - root.main-quota-y;
            background: DesignTokens.main-canvas;
            z: 5;
            Text {
                x: 0px;
                y: parent.height / 2 - 24px;
                width: parent.width;
                height: 28px;
                text: "◌  " + root.strings.checking;
                color: DesignTokens.text-secondary;
                font-size: DesignTokens.text-body;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
