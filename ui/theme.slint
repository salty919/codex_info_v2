// 画面全体で共有するデザイン値。個々の部品に色や余白を持たせない。
export global DesignTokens {
    out property <color> canvas: #0d131e;
    out property <color> canvas-warning: #171a20;
    out property <color> canvas-error: #1c171c;
    out property <color> raised: #141d2d;
    out property <color> border-subtle: #2d3d56;
    out property <color> text-primary: #f5f7fb;
    out property <color> text-secondary: #a7b5c9;
    out property <color> text-muted: #78879c;
    out property <color> accent-primary: #56b2f5;
    out property <color> accent-muted: #326799;
    out property <color> warning: #e6a23c;
    out property <color> danger: #ef6a6a;
    out property <color> success: #5dc98a;
    out property <color> chart-grid: #263850;
    out property <color> graph-control-surface: #111b2c;
    out property <color> graph-control-hover: #1c3150;
    out property <color> graph-control-selected: #244d74;
    out property <color> graph-control-border: #405779;
    out property <color> graph-plot-surface: #121c2c;
    out property <color> graph-plot-border: #3b506f;
    // A dedicated, visible-but-neutral fill for intervals with no model use.
    // Keep this separate from text-muted so idle bands cannot disappear when
    // text contrast is tuned independently.
    out property <color> graph-idle-band: #3f5d7c;
    out property <color> graph-remaining: #56b2f5;
    out property <color> graph-sol: #a88cf5;
    out property <color> graph-terra: #5dc98a;
    out property <color> graph-luna: #e6a23c;
    // ASTRA uses the existing danger theme color so the new model remains
    // distinct without introducing an unbounded palette.
    out property <color> graph-astra: #ef6a6a;

    out property <length> outer-margin-wide: 30px;
    out property <length> outer-margin-compact: 20px;
    out property <length> content-max-width: 840px;
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 20px;
    out property <length> space-6: 24px;
    out property <length> radius-control: 6px;
    out property <length> radius-surface: 10px;
    out property <length> control-height: 36px;

    out property <length> text-caption: 13px;
    out property <length> text-body: 14px;
    out property <length> text-heading: 16px;
    out property <length> text-reset: 24px;
    out property <length> text-hero: 48px;
}
