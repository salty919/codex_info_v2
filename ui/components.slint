// Frameless windows keep their system-independent controls in the application
// surface. The glyphs are deliberately ASCII/Unicode symbols rather than
// translated words so the controls stay compact in every locale.
export component WindowControlButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> destructive: false;
    callback activated();
    width: 36px;
    height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: control-touch.has-hover
        ? (root.destructive ? DesignTokens.danger : DesignTokens.graph-control-border)
        : DesignTokens.border-subtle;
    background: control-touch.has-hover
        ? (root.destructive ? #3b2028 : DesignTokens.graph-control-hover)
        : DesignTokens.graph-control-surface;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.glyph;
        color: root.destructive && control-touch.has-hover
            ? DesignTokens.danger
            : DesignTokens.text-primary;
        font-size: root.glyph == "×" ? 18px : 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    control-touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
}

export component WindowControls inherits Rectangle {
    in property <bool> show-maximize: false;
    in property <bool> maximized: false;
    callback minimize();
    callback toggle-maximize();
    callback close();
    width: root.show-maximize ? 108px : 72px;
    height: 28px;

    WindowControlButton {
        x: 0px;
        glyph: "-";
        activated => { root.minimize(); }
    }
    if root.show-maximize : WindowControlButton {
        x: 36px;
        glyph: root.maximized ? "❐" : "□";
        activated => { root.toggle-maximize(); }
    }
    WindowControlButton {
        x: root.show-maximize ? 72px : 36px;
        glyph: "×";
        destructive: true;
        activated => { root.close(); }
    }
}

// The first left-button press is handed to winit so the window manager owns
// the drag gesture. Controls are layered above this area at each call site.
export component WindowDragArea inherits TouchArea {
    callback begin-drag();
    mouse-cursor: MouseCursor.move;
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
            root.begin-drag();
        }
    }
}

// WSLg may report the compositor wrapper as decorated even after `no-frame`.
// Graph therefore exposes explicit edge/corner handles in addition to
// Slint's built-in frameless resize-border support.
export component WindowResizeHandle inherits TouchArea {
    in property <string> direction;
    in property <MouseCursor> resize-cursor: MouseCursor.default;
    in property <bool> corner: false;
    callback begin-resize(string);
    mouse-cursor: root.resize-cursor;

    // Keep the hit target visually quiet until the pointer reaches it. The
    // enlarged corner target remains discoverable through the diagonal cursor
    // and a subtle hover tint instead of changing the graph's plot geometry.
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        visible: root.has-hover;
        background: DesignTokens.accent-primary;
        opacity: root.corner ? 0.24 : 0.12;
    }

    // A small always-visible bracket makes the enlarged corner target
    // discoverable even before the pointer reaches it. The hit area remains
    // the full 28px square; this mark is only a visual affordance.
    Rectangle {
        visible: root.corner;
        x: root.direction == "north-east" || root.direction == "south-east"
            ? parent.width - 12px : 2px;
        y: root.direction == "south-west" || root.direction == "south-east"
            ? parent.height - 12px : 2px;
        width: 10px;
        height: 10px;
        border-width: 1px;
        border-radius: 2px;
        border-color: DesignTokens.accent-primary;
        opacity: 0.48;
    }

    pointer-event(event) => {
        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
            root.begin-resize(root.direction);
        }
    }
}

