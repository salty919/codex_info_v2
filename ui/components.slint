// Frameless windows keep their system-independent controls in the application
// surface. The glyphs are deliberately ASCII/Unicode symbols rather than
// translated words so the controls stay compact in every locale.
export component WindowControlButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> destructive: false;
    in property <length> control-width: 36px;
    callback activated();
    width: root.control-width;
    height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: control-touch.has-hover
        ? (root.destructive ? DesignTokens.danger : DesignTokens.graph-control-border)
        : DesignTokens.border-subtle;
    background: control-touch.has-hover
        ? (root.destructive ? #3b2028 : DesignTokens.graph-control-hover)
        : DesignTokens.graph-control-surface;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.glyph;
        color: root.destructive && control-touch.has-hover
            ? DesignTokens.danger
            : DesignTokens.text-primary;
        font-size: root.glyph == "×" ? 18px : 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    control-touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
}

export component WindowControls inherits Rectangle {
    in property <bool> show-maximize: false;
    in property <bool> maximized: false;
    in property <bool> compact: false;
    private property <length> control-width: root.compact ? 30px : 36px;
    callback minimize();
    callback toggle-maximize();
    callback close();
    width: root.show-maximize ? 3 * root.control-width : 2 * root.control-width;
    height: 28px;

    WindowControlButton {
        x: 0px;
        control-width: root.control-width;
        glyph: "-";
        activated => { root.minimize(); }
    }
    if root.show-maximize : WindowControlButton {
        x: root.control-width;
        control-width: root.control-width;
        glyph: root.maximized ? "❐" : "□";
        activated => { root.toggle-maximize(); }
    }
    WindowControlButton {
        x: root.show-maximize ? 2 * root.control-width : root.control-width;
        control-width: root.control-width;
        glyph: "×";
        destructive: true;
        activated => { root.close(); }
    }
}

// The first left-button press is handed to winit so the window manager owns
// the drag gesture. Controls are layered above this area at each call site.
export component WindowDragArea inherits TouchArea {
    callback begin-drag();
    mouse-cursor: MouseCursor.move;
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
            root.begin-drag();
        }
    }
}

// WSLg may report the compositor wrapper as decorated even after `no-frame`.
// Graph therefore exposes explicit edge/corner handles in addition to
// Slint's built-in frameless resize-border support.
export component WindowResizeHandle inherits TouchArea {
    in property <string> direction;
    in property <MouseCursor> resize-cursor: MouseCursor.default;
    in property <bool> corner: false;
    callback begin-resize(string);
    mouse-cursor: root.resize-cursor;

    // Keep the hit target visually quiet until the pointer reaches it. The
    // enlarged corner target remains discoverable through the diagonal cursor
    // and a subtle hover tint instead of changing the graph's plot geometry.
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        visible: root.has-hover;
        background: DesignTokens.accent-primary;
        opacity: root.corner ? 0.24 : 0.12;
    }

    // A small always-visible bracket makes the enlarged corner target
    // discoverable even before the pointer reaches it. The hit area remains
    // the full 28px square; this mark is only a visual affordance.
    Rectangle {
        visible: root.corner;
        x: root.direction == "north-east" || root.direction == "south-east"
            ? parent.width - 12px : 2px;
        y: root.direction == "south-west" || root.direction == "south-east"
            ? parent.height - 12px : 2px;
        width: 10px;
        height: 10px;
        border-width: 1px;
        border-radius: 2px;
        border-color: DesignTokens.accent-primary;
        opacity: 0.48;
    }

    pointer-event(event) => {
        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
            root.begin-resize(root.direction);
        }
    }
}

export struct ActiveThreadRow {
    relation: string,
    is-main: bool,
    title: string,
    full-title: string,
    model: string,
    tokens: string,
    context-usage: string,
    thread-age: string,
    instruction-age: string,
    tree-depth: int,
    connected-to-parent: bool,
    has-children: bool,
    has-next-sibling: bool,
    ancestor-guide-1: bool,
    ancestor-guide-2: bool,
    ancestor-guide-3: bool,
}

export struct MainAccountOption {
    label: string,
    current: bool,
}

export component MainAccountSelect inherits Rectangle {
    in property <[MainAccountOption]> model;
    in property <int> current-index: 0;
    in property <string> empty-label;
    in property <string> field-label;
    callback selected(string);
    private property <bool> enabled: root.model.length > 0;
    property <length> item-height: 32px;
    height: 44px;
    border-radius: DesignTokens.radius-control;
    border-width: 1px;
    border-color: popup.is-open ? DesignTokens.accent-primary : DesignTokens.main-command-border;
    background: root.enabled ? DesignTokens.main-command : DesignTokens.main-canvas;

    Text {
        x: 10px;
        width: 14px;
        height: parent.height;
        visible: root.enabled && root.current-index >= 0 && root.current-index < root.model.length
            && root.model[root.current-index].current;
        text: "●";
        color: #5DC98A;
        font-size: DesignTokens.text-caption;
        vertical-alignment: center;
    }
    Text {
        x: 28px;
        y: 4px;
        width: parent.width - 54px;
        height: 11px;
        text: root.field-label;
        color: DesignTokens.accent-primary;
        font-size: 9px;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 28px;
        y: 15px;
        width: parent.width - 54px;
        height: parent.height - 18px;
        text: root.enabled && root.current-index >= 0 && root.current-index < root.model.length
            ? root.model[root.current-index].label : root.empty-label;
        color: root.enabled ? DesignTokens.main-text-primary : DesignTokens.text-muted;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - 24px;
        width: 14px;
        height: parent.height;
        text: popup.is-open ? "⌃" : "⌄";
        color: root.enabled ? DesignTokens.text-secondary : DesignTokens.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { popup.is-open ? popup.close() : popup.show(); }
    }
    popup := PopupWindow {
        y: root.height;
        width: max(root.width, 420px);
        height: min(4 * root.item-height + 2px, max(root.item-height + 2px, root.model.length * root.item-height + 2px));
        close-policy: close-on-click;
        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: DesignTokens.radius-control;
            border-width: 1px;
            border-color: DesignTokens.graph-control-border;
            background: DesignTokens.graph-control-surface;
            clip: true;
            list := ListView {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                for value[index] in root.model : Rectangle {
                    width: list.visible-width;
                    height: root.item-height;
                    background: item-touch.has-hover ? DesignTokens.graph-control-hover
                        : (index == root.current-index ? DesignTokens.graph-control-selected : DesignTokens.graph-control-surface);
                    Text {
                        x: 10px;
                        width: 14px;
                        height: parent.height;
                        visible: value.current;
                        text: "●";
                        color: #5DC98A;
                        font-size: DesignTokens.text-caption;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 28px;
                        width: parent.width - 40px;
                        height: parent.height;
                        text: value.label;
                        color: DesignTokens.text-primary;
                        font-size: DesignTokens.text-caption;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    item-touch := TouchArea {
                        clicked => {
                            root.selected(value.label);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

export component GraphSelect inherits Rectangle {
    in property <[string]> model;
    in property <string> empty-label;
    in property <bool> selectable: true;
    in property <int> current-index: 0;
    // The placeholder row is informational only; it must not open a
    // selectable popup when there is no history.
    // enabled: root.model.length > 0 && !(root.model.length == 1 && root.model[0] == "履歴なし");
    in property <bool> enabled: root.selectable && root.model.length > 0;
    in property <bool> open-on-start: false;
    in property <bool> popup-above: false;
    in property <length> popup-x: 0px;
    in property <length> popup-width: root.width;
    in property <int> max-visible-items: 4;
    in property <string> field-label: "";
    out property <bool> popup-open: popup.is-open;
    // Keep the two-pixel border outside the row viewport. Callers choose how
    // many complete rows fit their surface; a long list scrolls inside it.
    out property <length> popup-height: min(root.max-visible-items * root.item-height + 2px, max(root.item-height + 2px, root.model.length * root.item-height + 2px));
    callback selected(string);
    private property <bool> startup-popup-shown: false;
    property <length> item-height: 32px;
    height: 36px;
    border-radius: DesignTokens.radius-control;
    border-width: 1px;
    border-color: popup.is-open ? DesignTokens.accent-primary : DesignTokens.graph-control-border;
    background: root.enabled ? (popup.is-open ? DesignTokens.graph-control-selected : DesignTokens.graph-control-surface) : DesignTokens.canvas;

    Text {
        x: 12px;
        y: 0px;
        width: root.field-label == "" ? 0px : 82px;
        height: parent.height;
        visible: root.field-label != "";
        text: root.field-label;
        color: DesignTokens.accent-primary;
        font-size: DesignTokens.text-caption;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: 101px;
        y: 8px;
        width: 1px;
        height: parent.height - 16px;
        visible: root.field-label != "";
        background: DesignTokens.graph-control-border;
    }
    Text {
        x: root.field-label == "" ? 12px : 112px;
        y: 0px;
        width: parent.width - self.x - 26px;
        height: parent.height;
        text: root.enabled && root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : root.empty-label;
        color: root.enabled ? DesignTokens.text-primary : DesignTokens.text-muted;
        font-size: DesignTokens.text-caption;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - 26px;
        y: 0px;
        width: 14px;
        height: parent.height;
        text: popup.is-open ? "⌃" : "⌄";
        color: root.enabled ? DesignTokens.text-secondary : DesignTokens.text-muted;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        enabled: root.enabled;
        clicked => {
            if popup.is-open {
                popup.close();
            } else {
                popup.show();
            }
        }
    }

    // Preview-only callers can request one deterministic open state for
    // visual acceptance captures. Normal product windows leave this false.
    Timer {
        interval: 100ms;
        running: root.open-on-start && root.enabled && !root.startup-popup-shown;
        triggered => {
            root.startup-popup-shown = true;
            popup.show();
        }
    }

    popup := PopupWindow {
        x: root.popup-x;
        // A short history list is fully visible. Longer histories keep a
        // bounded panel and scroll inside ListView instead of hiding entries.
        y: root.popup-above ? 0px : root.height;
        width: root.popup-width;
        height: root.popup-height;
        // Keep list navigation under explicit user control. Selecting a row
        // or clicking the selector again closes it; delayed/synthetic outside
        // events must not destroy an in-progress scroll.
        close-policy: no-auto-close;
        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: DesignTokens.radius-control;
            border-width: 1px;
            border-color: DesignTokens.graph-control-border;
            background: DesignTokens.graph-control-surface;
            clip: true;
            popup-list := ListView {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                viewport-width: self.width;
                // A persistent rail makes the scroll affordance visible.
                // Drag-panning also avoids forcing the user to acquire the
                // narrow rail at the far edge of a long selector.
                vertical-scrollbar-policy: root.model.length > root.max-visible-items ? ScrollBarPolicy.always-on : ScrollBarPolicy.always-off;
                mouse-drag-pan-enabled: true;
                for value[index] in root.model : Rectangle {
                    // Reserve space beside a visible scroll bar. Missing the
                    // rail must not activate a row and close the popup.
                    width: popup-list.visible-width - (root.model.length > root.max-visible-items ? 22px : 0px);
                    height: root.item-height;
                    background: item-touch.has-hover ? DesignTokens.graph-control-hover : (index == root.current-index ? DesignTokens.graph-control-selected : DesignTokens.graph-control-surface);
                    Text {
                        x: 11px;
                        width: parent.width - 22px;
                        height: parent.height;
                        text: value;
                        color: DesignTokens.text-primary;
                        font-size: DesignTokens.text-caption;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    item-touch := TouchArea {
                        clicked => {
                            root.selected(value);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

export component Header inherits Rectangle {
    in property <UiStrings> strings;
    in property <bool> show-graph: false;
    in property <[MainAccountOption]> account-options;
    in property <int> selected-account-index: 0;
    callback open-graph();
    callback select-account(string);
    callback open-legal-notice();
    callback open-settings();
    callback begin-window-drag();
    callback minimize-window();
    callback close-window();
    property <length> settings-button-width: 70px;
    property <length> legal-button-width: 84px;
    property <length> graph-button-width: 70px;
    property <length> account-select-width: 250px;
    property <length> window-control-width: 60px;
    private property <bool> show-account-selector: root.account-options.length > 0;
    private property <length> account-x: 220px;
    private property <length> settings-x: root.width - root.window-control-width - 16px - root.settings-button-width;
    private property <length> legal-x: root.settings-x - 4px - root.legal-button-width;
    private property <length> graph-x: root.legal-x - 4px - root.graph-button-width;
    height: 52px;

    WindowDragArea {
        x: 0px;
        y: 0px;
        width: root.graph-x;
        height: parent.height;
        begin-drag => { root.begin-window-drag(); }
    }

    app-mark := Rectangle {
        x: 0px;
        y: 8px;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        border-width: 1px;
        border-color: DesignTokens.accent-primary;
        background: DesignTokens.main-app-mark;
        Text {
            width: parent.width;
            height: parent.height;
            text: "◈";
            color: DesignTokens.main-text-primary;
            font-size: 20px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: 46px;
        y: 3px;
        width: 154px;
        height: 28px;
        text: root.strings.usage-status;
        color: DesignTokens.main-heading;
        font-size: 22px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 46px;
        y: 31px;
        width: 154px;
        height: 17px;
        text: root.strings.product-version;
        color: DesignTokens.main-label;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    MainAccountSelect {
        x: root.account-x;
        y: 4px;
        width: 250px;
        height: 44px;
        visible: root.show-account-selector;
        model: root.account-options;
        empty-label: root.strings.account-selector-heading;
        field-label: root.strings.account-selector-heading;
        current-index: root.selected-account-index;
        selected(value) => { root.select-account(value); }
    }
    Rectangle {
        x: root.graph-x;
        y: 10px;
        width: root.graph-button-width;
        height: 32px;
        border-radius: 6px;
        border-width: 1px;
        border-color: DesignTokens.main-command-border;
        background: DesignTokens.main-command;
        visible: root.show-graph;
        Text {
            x: 4px;
            width: parent.width - 8px;
            height: parent.height;
            text: "▥ " + root.strings.graph;
            color: DesignTokens.main-text-primary;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        TouchArea { clicked => { root.open-graph(); } }
    }
    Rectangle {
        x: root.legal-x;
        y: 10px;
        width: root.legal-button-width;
        height: 32px;
        border-radius: 6px;
        border-width: 1px;
        border-color: DesignTokens.main-command-border;
        background: DesignTokens.main-command;
        Text {
            x: 4px;
            width: parent.width - 8px;
            height: parent.height;
            text: "ⓘ " + root.strings.legal-notices;
            color: DesignTokens.main-text-primary;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        TouchArea {
            clicked => { root.open-legal-notice(); }
        }
    }
    Rectangle {
        x: root.settings-x;
        y: 10px;
        width: root.settings-button-width;
        height: 32px;
        border-radius: 6px;
        border-width: 1px;
        border-color: DesignTokens.main-command-border;
        background: DesignTokens.main-command;
        Text {
            x: 4px;
            width: parent.width - 8px;
            height: parent.height;
            text: "⚙ " + root.strings.settings;
            color: DesignTokens.main-text-primary;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        TouchArea { clicked => { root.open-settings(); } }
    }
    WindowControls {
        x: parent.width - root.window-control-width;
        y: 12px;
        show-maximize: false;
        compact: true;
        minimize => { root.minimize-window(); }
        close => { root.close-window(); }
    }

}

export component RemainingQuota inherits Rectangle {
    in property <string> quota-title;
    in property <string> remaining-label;
    in property <string> estimated-cost-label;
    in property <float> remaining-percent;
    in property <bool> has-quota-percent: true;
    height: 82px;
    border-radius: 8px;
    border-width: 1px;
    border-color: DesignTokens.main-section-border;
    background: DesignTokens.main-section;

    Text {
        x: 14px;
        y: 6px;
        width: parent.width - 28px;
        height: 16px;
        text: root.quota-title;
        color: DesignTokens.main-label;
        font-size: 12px;
        font-weight: 700;
        vertical-alignment: center;
    }
    Text {
        x: 14px;
        y: 20px;
        width: parent.width - 252px;
        height: 46px;
        text: remaining-label;
        color: DesignTokens.main-text-primary;
        font-size: 36px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - 224px;
        y: 20px;
        width: 210px;
        height: 46px;
        text: root.estimated-cost-label;
        visible: root.has-quota-percent;
        color: DesignTokens.main-estimate;
        font-size: 20px;
        font-weight: 700;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    if root.has-quota-percent : Rectangle {
        x: 14px;
        y: 70px;
        width: parent.width - 28px;
        height: 6px;
        // Avoid a rounded clip here. Slint's X11 software renderer leaks this
        // specific dynamic full-width clip into later rows at 100%. The fill
        // stays a simple left-to-right bar in every boundary state.
        background: DesignTokens.accent-muted;
    }
    if root.has-quota-percent && root.remaining-percent > 0 : Rectangle {
        x: 14px;
        y: 70px;
        // Keep the software renderer away from its exact parent-width clip
        // edge. 0.01px is sub-pixel at the supported scale and renders as a
        // visually full 100% bar without corrupting subsequent rows.
        width: min(
            parent.width - 28.01px,
            (parent.width - 28px) * min(100, max(0, root.remaining-percent)) / 100
        );
        height: 6px;
        background: DesignTokens.accent-primary;
    }
}

component DaySegment inherits Rectangle {
    in property <float> fill;
    background: DesignTokens.accent-muted;
}

component DayFill inherits Rectangle {
    background: DesignTokens.accent-primary;
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> refresh-style: false;
    in property <bool> enabled: true;
    // Close buttons must hide their window on pointer-down. Other actions keep
    // the normal click-on-release behavior so they are not triggered twice.
    in property <bool> activate-on-press: false;
    in property <bool> reset-press-state: false;
    property <bool> suppress-next-click: false;
    callback clicked();
    changed reset-press-state => {
        if (self.reset-press-state) {
            self.suppress-next-click = false;
        }
    }
    height: DesignTokens.control-height;
    border-radius: DesignTokens.radius-control;
    border-width: 1px;
    border-color: root.refresh-style ? DesignTokens.main-refresh-border
        : root.primary ? DesignTokens.accent-primary : DesignTokens.border-subtle;
    background: root.refresh-style
        ? (touch-area.pressed ? DesignTokens.graph-control-hover : DesignTokens.main-refresh)
        : root.primary
        ? (touch-area.pressed ? DesignTokens.accent-muted : DesignTokens.accent-primary)
        : (touch-area.pressed ? DesignTokens.graph-control-selected : DesignTokens.raised);

    Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.text;
        color: root.refresh-style ? DesignTokens.main-text-primary
            : root.primary ? DesignTokens.canvas : DesignTokens.text-primary;
        font-size: DesignTokens.text-body;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: root.enabled ? 1 : 0.5;
    }
    touch-area := TouchArea {
        enabled: root.enabled && !root.reset-press-state;
        changed pressed => {
            if (root.activate-on-press && self.pressed) {
                root.suppress-next-click = true;
                root.clicked();
            }
        }
        clicked => {
            if (root.suppress-next-click) {
                root.suppress-next-click = false;
            } else {
                root.clicked();
            }
        }
    }
}

export component WeekGauge inherits Rectangle {
    in property <float> remaining-days;
    in property <string> period-title;
    in property <string> remaining-label;
    in property <string> reset-label;
    in property <string> reset-value;
    in property <string> observed-label;
    in property <string> observed-value;
    in property <bool> show-gauge: true;
    property <length> segment-width: (root.width - 48px) / 7;
    height: 78px;
    border-radius: 8px;
    border-width: 1px;
    border-color: DesignTokens.main-section-border;
    background: DesignTokens.main-section;

    Text {
        x: 12px;
        y: 5px;
        width: parent.width - 296px;
        height: 18px;
        text: root.period-title;
        color: DesignTokens.main-label;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - 284px;
        y: 5px;
        width: 272px;
        height: 18px;
        text: root.remaining-label;
        color: DesignTokens.main-text-primary;
        font-size: 13px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
    DaySegment {
        x: 12px;
        y: 24px;
        width: root.segment-width;
        height: 20px;
        fill: root.remaining-days;
        visible: root.show-gauge;
    }
    DaySegment {
        x: 12px + root.segment-width + 4px;
        y: 24px;
        width: root.segment-width;
        height: 20px;
        fill: root.remaining-days - 1;
        visible: root.show-gauge;
    }
    DaySegment {
        x: 12px + 2 * (root.segment-width + 4px);
        y: 24px;
        width: root.segment-width;
        height: 20px;
        fill: root.remaining-days - 2;
        visible: root.show-gauge;
    }
    DaySegment {
        x: 12px + 3 * (root.segment-width + 4px);
        y: 24px;
        width: root.segment-width;
        height: 20px;
        fill: root.remaining-days - 3;
        visible: root.show-gauge;
    }
    DaySegment {
        x: 12px + 4 * (root.segment-width + 4px);
        y: 24px;
        width: root.segment-width;
        height: 20px;
        fill: root.remaining-days - 4;
        visible: root.show-gauge;
    }
    DaySegment {
        x: 12px + 5 * (root.segment-width + 4px);
        y: 24px;
        width: root.segment-width;
        height: 20px;
        fill: root.remaining-days - 5;
        visible: root.show-gauge;
    }
    DaySegment {
        x: 12px + 6 * (root.segment-width + 4px);
        y: 24px;
        width: root.segment-width;
        height: 20px;
        fill: root.remaining-days - 6;
        visible: root.show-gauge;
    }
    if root.show-gauge && root.remaining-days > 0 : DayFill { x: 12px; y: 24px; width: min(root.segment-width - 1px, root.segment-width * min(1, root.remaining-days)); height: 20px; }
    if root.show-gauge && root.remaining-days - 1 > 0 : DayFill { x: 12px + root.segment-width + 4px; y: 24px; width: min(root.segment-width - 1px, root.segment-width * min(1, root.remaining-days - 1)); height: 20px; }
    if root.show-gauge && root.remaining-days - 2 > 0 : DayFill { x: 12px + 2 * (root.segment-width + 4px); y: 24px; width: min(root.segment-width - 1px, root.segment-width * min(1, root.remaining-days - 2)); height: 20px; }
    if root.show-gauge && root.remaining-days - 3 > 0 : DayFill { x: 12px + 3 * (root.segment-width + 4px); y: 24px; width: min(root.segment-width - 1px, root.segment-width * min(1, root.remaining-days - 3)); height: 20px; }
    if root.show-gauge && root.remaining-days - 4 > 0 : DayFill { x: 12px + 4 * (root.segment-width + 4px); y: 24px; width: min(root.segment-width - 1px, root.segment-width * min(1, root.remaining-days - 4)); height: 20px; }
    if root.show-gauge && root.remaining-days - 5 > 0 : DayFill { x: 12px + 5 * (root.segment-width + 4px); y: 24px; width: min(root.segment-width - 1px, root.segment-width * min(1, root.remaining-days - 5)); height: 20px; }
    if root.show-gauge && root.remaining-days - 6 > 0 : DayFill { x: 12px + 6 * (root.segment-width + 4px); y: 24px; width: min(root.segment-width - 1px, root.segment-width * min(1, root.remaining-days - 6)); height: 20px; }
    Text { x: 12px; y: 49px; width: 84px; height: 20px;
        text: root.reset-label; color: DesignTokens.main-label; font-size: 11px;
        vertical-alignment: center; overflow: elide; }
    Text { x: 104px; y: 49px; width: parent.width - 548px; height: 20px;
        text: root.reset-value; color: DesignTokens.main-text-primary; font-size: 11px;
        vertical-alignment: center; overflow: elide; }
    Text { x: parent.width - 412px; y: 49px; width: 116px; height: 20px;
        text: root.observed-label; color: DesignTokens.main-label; font-size: 11px;
        vertical-alignment: center; overflow: elide; }
    Text { x: parent.width - 288px; y: 49px; width: 276px; height: 20px;
        text: root.observed-value; color: DesignTokens.main-text-primary; font-size: 11px;
        horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
}

component ThreadModelStat inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <color> indicator-color;
    width: 80px;
    height: 42px;

    Text {
        x: 0px;
        y: 2px;
        width: parent.width;
        height: 14px;
        text: root.label;
        color: root.indicator-color;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 0px;
        y: 17px;
        width: parent.width;
        height: 22px;
        text: root.count;
        color: root.indicator-color;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component AccountActivity inherits Rectangle {
    in property <UiStrings> strings;
    in property <string> active-thread-count-label;
    in property <bool> show-content: true;
    in property <bool> has-active-thread: false;
    in property <int> active-thread-count: 0;
    in property <int> sol-count: 0;
    in property <int> terra-count: 0;
    in property <int> luna-count: 0;
    in property <int> astra-count: 0;
    in property <int> other-count: 0;
    callback open-threads();
    private property <length> model-area-x: 260px;
    private property <length> model-stat-width: (root.width - 348px) / 5;
    height: 56px;
    border-radius: 8px;
    border-width: 1px;
    border-color: DesignTokens.main-section-border;
    background: DesignTokens.main-section;

    Text {
        x: 12px;
        y: 5px;
        width: 240px;
        height: 14px;
        visible: root.show-content;
        text: root.strings.active-threads;
        color: DesignTokens.main-label;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
    }
    if root.show-content && root.has-active-thread : Text {
        x: 12px;
        y: 18px;
        width: 240px;
        height: 30px;
        text: root.active-thread-count-label;
        color: DesignTokens.main-text-primary;
        font-size: 22px;
        font-weight: 700;
        vertical-alignment: center;
    }
    if root.show-content && root.has-active-thread : ThreadModelStat {
        x: root.model-area-x;
        y: 7px;
        width: root.model-stat-width;
        label: "SOL";
        count: root.sol-count;
        indicator-color: DesignTokens.main-thread-sol;
    }
    if root.show-content && root.has-active-thread : ThreadModelStat {
        x: root.model-area-x + root.model-stat-width;
        y: 7px;
        width: root.model-stat-width;
        label: "TERRA";
        count: root.terra-count;
        indicator-color: DesignTokens.main-thread-terra;
    }
    if root.show-content && root.has-active-thread : ThreadModelStat {
        x: root.model-area-x + 2 * root.model-stat-width;
        y: 7px;
        width: root.model-stat-width;
        label: "LUNA";
        count: root.luna-count;
        indicator-color: DesignTokens.main-thread-luna;
    }
    if root.show-content && root.has-active-thread : ThreadModelStat {
        x: root.model-area-x + 3 * root.model-stat-width;
        y: 7px;
        width: root.model-stat-width;
        label: "ASTRA";
        count: root.astra-count;
        indicator-color: DesignTokens.main-thread-astra;
    }
    if root.show-content && root.has-active-thread : ThreadModelStat {
        x: root.model-area-x + 4 * root.model-stat-width;
        y: 7px;
        width: root.model-stat-width;
        label: root.strings.other;
        count: root.other-count;
        indicator-color: DesignTokens.main-label;
    }
    if root.show-content && root.has-active-thread : ActionButton {
        x: parent.width - 80px;
        y: 13px;
        width: 68px;
        height: 30px;
        text: root.strings.details;
        primary: false;
        refresh-style: true;
        clicked => { root.open-threads(); }
    }
    if root.show-content && !root.has-active-thread : Text {
        x: 12px;
        y: 24px;
        width: parent.width - 24px;
        height: 20px;
        text: root.strings.no-running-threads;
        color: DesignTokens.main-label;
        font-size: 12px;
        vertical-alignment: center;
    }
}

export component LegalNoticeWindow inherits Window {
    preferred-width: 720px;
    preferred-height: 520px;
    min-width: 720px;
    max-width: 720px;
    min-height: 520px;
    max-height: 520px;
    // WM metadata remains ASCII-safe for task switching, while the visible
    // title and controls are rendered inside this frameless surface.
    in-out property <string> window-title;
    in property <UiStrings> strings;
    in-out property <int> legal-page-index: 0;
    in-out property <bool> reset-close-buttons: false;
    no-frame: true;
    resize-border-width: 0px;
    title: root.window-title;
    background: DesignTokens.canvas;
    default-font-family: root.strings.font-family;

    changed maximized => {
        if (self.maximized) {
            self.maximized = false;
        }
    }
    changed full-screen => {
        if (self.full-screen) {
            self.full-screen = false;
        }
    }

    callback close-legal-notice();
    callback begin-window-drag();
    callback minimize-window();
    callback close-window();
    callback legal-page-back();
    callback legal-page-next();

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: DesignTokens.canvas;
        z: -10;
    }
    WindowDragArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        z: -5;
        begin-drag => { root.begin-window-drag(); }
    }

    Rectangle {
        x: 28px;
        y: 22px;
        width: parent.width - 56px;
        height: parent.height - 44px;
        border-radius: DesignTokens.radius-surface;
        border-width: 1px;
        border-color: DesignTokens.border-subtle;
        background: DesignTokens.raised;

        WindowDragArea {
            x: 1px;
            y: 1px;
            width: parent.width - 74px;
            height: 48px;
            begin-drag => { root.begin-window-drag(); }
        }

        Text {
            x: 20px;
            y: 16px;
            width: parent.width - 136px;
            height: 30px;
            text: root.strings.legal-notices;
            color: DesignTokens.text-primary;
            font-size: 22px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            x: 20px;
            y: 58px;
            width: parent.width - 40px;
            height: 22px;
            text: root.strings.legal-page-names.length > 0 && root.legal-page-index >= 0 && root.legal-page-index < root.strings.legal-page-names.length
                ? root.strings.legal-page-names[root.legal-page-index]
                : root.strings.legal-details;
            color: DesignTokens.accent-primary;
            font-size: DesignTokens.text-body;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle {
            x: 20px;
            y: 88px;
            width: parent.width - 40px;
            height: 328px;
            clip: true;
            border-width: 1px;
            border-radius: DesignTokens.radius-control;
            border-color: DesignTokens.border-subtle;
            background: DesignTokens.canvas;
            Text {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                height: parent.height - 20px;
                text: root.strings.legal-pages.length > 0 && root.legal-page-index >= 0 && root.legal-page-index < root.strings.legal-pages.length
                    ? root.strings.legal-pages[root.legal-page-index]
                    : root.strings.legal-details;
                color: DesignTokens.text-secondary;
                font-size: DesignTokens.text-caption;
                vertical-alignment: top;
                wrap: char-wrap;
            }
        }
        Text {
            x: 20px;
            y: 428px;
            width: 180px;
            height: 24px;
            text: root.strings.legal-page-position + " " + (root.legal-page-index + 1) + " / " + root.strings.legal-pages.length;
            color: DesignTokens.text-muted;
            font-size: DesignTokens.text-caption;
            vertical-alignment: center;
        }
        ActionButton {
            x: parent.width - 252px;
            y: 424px;
            width: 92px;
            text: root.strings.legal-back;
            enabled: root.legal-page-index > 0;
            clicked => { root.legal-page-back(); }
        }
        ActionButton {
            x: parent.width - 152px;
            y: 424px;
            width: 92px;
            text: root.strings.legal-next;
            enabled: root.legal-page-index + 1 < root.strings.legal-pages.length;
            primary: true;
            clicked => { root.legal-page-next(); }
        }
        WindowControls {
            x: parent.width - 72px;
            y: 10px;
            show-maximize: false;
            minimize => { root.minimize-window(); }
            close => { root.close-window(); }
        }
    }
}

export component ThreadsWindow inherits Window {
    preferred-width: 900px;
    preferred-height: 480px;
    min-width: 900px;
    max-width: 900px;
    min-height: 480px;
    max-height: 480px;
    in-out property <string> window-title;
    in property <UiStrings> strings;
    in property <string> thread-count-label;
    in-out property <bool> reset-close-buttons: false;
    no-frame: true;
    resize-border-width: 0px;
    title: root.window-title;
    background: DesignTokens.canvas;
    default-font-family: root.strings.font-family;

    changed maximized => {
        if (self.maximized) {
            self.maximized = false;
        }
    }
    changed full-screen => {
        if (self.full-screen) {
            self.full-screen = false;
        }
    }

    in property <[ActiveThreadRow]> thread-rows;
    callback close-threads();
    callback begin-window-drag();
    callback minimize-window();
    callback close-window();
    // The 384px list viewport owns four complete 96px rows. Each row contains
    // a 92px card and a 4px gap, independent of the number of active threads.
    property <length> thread-row-height: 96px;

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: DesignTokens.canvas;
        z: -10;
    }
    WindowDragArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        z: -5;
        begin-drag => { root.begin-window-drag(); }
    }

    header-panel := Rectangle {
        x: 20px;
        y: 20px;
        width: 860px;
        height: 30px;
        background: DesignTokens.canvas;
        z: 2;
        WindowDragArea {
            x: 0px;
            y: 0px;
            width: parent.width - 74px;
            height: parent.height;
            begin-drag => { root.begin-window-drag(); }
        }
        Text {
            x: 0px;
            y: 0px;
            width: parent.width - 82px;
            height: 30px;
            text: root.strings.active-threads;
            color: DesignTokens.text-primary;
            font-size: 22px;
            font-weight: 700;
            vertical-alignment: center;
            z: 2;
        }
        WindowControls {
            x: parent.width - 72px;
            y: 1px;
            show-maximize: false;
            z: 3;
            minimize => { root.minimize-window(); }
            close => { root.close-window(); }
        }
    }

    thread-count := Text {
        x: 20px;
        y: 56px;
        width: 860px;
        height: 14px;
        text: root.thread-count-label;
        color: DesignTokens.text-secondary;
        font-size: 12px;
        vertical-alignment: center;
    }

    thread-list-clip := Rectangle {
        x: 20px;
        y: 76px;
        width: 860px;
        height: 384px;
        clip: true;

        thread-list := ListView {
            width: parent.width;
            height: parent.height;
            viewport-width: self.width;

            for row[index] in root.thread-rows: Rectangle {
                width: thread-list.visible-width;
                height: root.thread-row-height;
                background: DesignTokens.canvas;
                property <int> display-depth: min(row.tree-depth, 3);
                property <length> tree-gutter-width: 64px;
                property <length> tree-base-x: 8px;
                property <length> tree-depth-step: 12px;
                property <length> tree-junction-y: 48px;
                property <length> tree-junction-end-x: self.tree-gutter-width - 5px;

                row-card := Rectangle {
                    width: parent.width;
                    height: 92px;
                    background: mod(index, 2) == 0 ? DesignTokens.raised : DesignTokens.canvas;
                    border-width: 1px;
                    border-color: DesignTokens.border-subtle;
                    border-radius: 6px;
                }

                // Every vertical rail owns the full 96px stride where the
                // relationship continues. A parent's lower half and its first
                // child's upper half therefore meet at the same row boundary.
                if row.ancestor-guide-1 : Rectangle {
                    x: parent.tree-base-x;
                    y: 0px;
                    width: 2px;
                    height: root.thread-row-height;
                    background: DesignTokens.warning;
                    opacity: 0.72;
                }
                if row.ancestor-guide-2 : Rectangle {
                    x: parent.tree-base-x + parent.tree-depth-step;
                    y: 0px;
                    width: 2px;
                    height: root.thread-row-height;
                    background: DesignTokens.warning;
                    opacity: 0.72;
                }
                if row.ancestor-guide-3 : Rectangle {
                    x: parent.tree-base-x + 2 * parent.tree-depth-step;
                    y: 0px;
                    width: 2px;
                    height: root.thread-row-height;
                    background: DesignTokens.warning;
                    opacity: 0.72;
                }
                if row.connected-to-parent : Rectangle {
                    x: parent.tree-base-x + (parent.display-depth - 1) * parent.tree-depth-step;
                    y: 0px;
                    width: 2px;
                    height: row.has-next-sibling ? root.thread-row-height : parent.tree-junction-y;
                    background: DesignTokens.warning;
                    opacity: 0.72;
                }
                if row.connected-to-parent : Rectangle {
                    x: parent.tree-base-x + (parent.display-depth - 1) * parent.tree-depth-step;
                    y: parent.tree-junction-y - 1px;
                    width: parent.tree-junction-end-x - self.x;
                    height: 2px;
                    background: DesignTokens.warning;
                    opacity: 0.72;
                }
                if row.connected-to-parent : Rectangle {
                    x: parent.tree-junction-end-x - 3px;
                    y: parent.tree-junction-y - 3px;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: DesignTokens.warning;
                    opacity: 0.82;
                }
                if row.has-children : Rectangle {
                    x: parent.tree-base-x + min(parent.display-depth, 3) * parent.tree-depth-step;
                    y: parent.tree-junction-y;
                    width: 2px;
                    height: root.thread-row-height - parent.tree-junction-y;
                    background: DesignTokens.warning;
                    opacity: 0.72;
                }

                role-lane := Rectangle {
                    x: 72px;
                    width: 110px;
                    height: 92px;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: row.relation + " · " + root.strings.running;
                        color: row.is-main ? DesignTokens.accent-primary : DesignTokens.warning;
                        font-size: 14px;
                        font-weight: 700;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
                title-lane := Rectangle {
                    x: 192px;
                    width: 242px;
                    height: 92px;
                    Text {
                        y: 26px;
                        width: parent.width;
                        height: 40px;
                        text: row.title;
                        accessible-role: text;
                        accessible-label: row.full-title;
                        color: DesignTokens.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                        vertical-alignment: center;
                        wrap: char-wrap;
                        overflow: clip;
                    }
                }
                model-lane := Rectangle {
                    x: 444px;
                    width: 190px;
                    height: 92px;
                    Text {
                        y: 21px;
                        width: parent.width;
                        height: 20px;
                        text: row.model;
                        color: DesignTokens.text-secondary;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        y: 47px;
                        width: parent.width;
                        height: 26px;
                        text: root.strings.context-usage + " " + row.context-usage;
                        color: DesignTokens.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        visible: row.context-usage != "";
                    }
                }
                time-lane := Rectangle {
                    x: 644px;
                    width: 180px;
                    height: 92px;
                    Text {
                        y: 16px;
                        width: parent.width;
                        height: 18px;
                        text: root.strings.running + " " + row.thread-age;
                        color: DesignTokens.text-secondary;
                        font-size: 12px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                        visible: row.thread-age != "";
                    }
                    Text {
                        y: 38px;
                        width: parent.width;
                        height: 18px;
                        text: root.strings.instruction + " " + row.instruction-age;
                        color: DesignTokens.text-secondary;
                        font-size: 12px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                        visible: row.instruction-age != "";
                    }
                    Text {
                        y: 60px;
                        width: parent.width;
                        height: 18px;
                        text: row.tokens;
                        color: DesignTokens.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                        visible: row.tokens != "";
                    }
                }
            }
        }
    }
}

export component ModelUsage inherits Rectangle {
    in property <UiStrings> strings;
    in property <bool> has-data: false;
    in property <string> model-names;
    in property <string> input-token-rows;
    in property <string> input-cost-rows;
    in property <string> cached-token-rows;
    in property <string> cached-cost-rows;
    in property <string> output-token-rows;
    in property <string> output-cost-rows;
    property <length> model-column-width: 108px;
    property <length> group-gap: 4px;
    property <length> group-width: (root.width - 24px - root.model-column-width - 3 * root.group-gap) / 3;
    property <length> dollar-width: 50px;
    height: 102px;
    border-radius: 8px;
    border-width: 1px;
    border-color: DesignTokens.main-section-border;
    background: DesignTokens.main-section;

    Text { x: 12px; y: 7px; width: root.model-column-width; height: 18px;
        text: root.strings.model; color: DesignTokens.main-label;
        font-size: DesignTokens.text-caption; vertical-alignment: center; overflow: elide; }
    Text { x: 12px + root.model-column-width + root.group-gap; y: 7px; width: root.group-width - root.dollar-width; height: 18px;
        text: root.strings.input; color: DesignTokens.main-label; font-size: DesignTokens.text-caption;
        horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
    Text { x: 12px + root.model-column-width + root.group-gap + root.group-width - root.dollar-width; y: 7px; width: root.dollar-width; height: 18px;
        text: "$"; color: DesignTokens.main-label; font-size: DesignTokens.text-caption;
        horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
    Text { x: 12px + root.model-column-width + 2 * root.group-gap + root.group-width; y: 7px; width: root.group-width - root.dollar-width; height: 18px;
        text: root.strings.cached; color: DesignTokens.main-label; font-size: DesignTokens.text-caption;
        horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
    Text { x: 12px + root.model-column-width + 2 * root.group-gap + 2 * root.group-width - root.dollar-width; y: 7px; width: root.dollar-width; height: 18px;
        text: "$"; color: DesignTokens.main-label; font-size: DesignTokens.text-caption;
        horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
    Text { x: 12px + root.model-column-width + 3 * root.group-gap + 2 * root.group-width; y: 7px; width: root.group-width - root.dollar-width; height: 18px;
        text: root.strings.output; color: DesignTokens.main-label; font-size: DesignTokens.text-caption;
        horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
    Text { x: 12px + root.model-column-width + 3 * root.group-gap + 3 * root.group-width - root.dollar-width; y: 7px; width: root.dollar-width; height: 18px;
        text: "$"; color: DesignTokens.main-label; font-size: DesignTokens.text-caption;
        horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
    Text { x: 12px; y: 28px; width: root.model-column-width; height: 66px;
        visible: root.has-data; text: root.model-names; color: DesignTokens.main-text-primary;
        font-size: DesignTokens.text-caption; vertical-alignment: top; overflow: elide; }
    Text { x: 12px + root.model-column-width + root.group-gap; y: 28px; width: root.group-width - root.dollar-width; height: 66px;
        visible: root.has-data; text: root.input-token-rows; color: DesignTokens.main-text-primary;
        font-size: DesignTokens.text-caption; horizontal-alignment: right; vertical-alignment: top; overflow: elide; }
    Text { x: 12px + root.model-column-width + root.group-gap + root.group-width - root.dollar-width; y: 28px; width: root.dollar-width; height: 66px;
        visible: root.has-data; text: root.input-cost-rows; color: DesignTokens.main-text-primary;
        font-size: DesignTokens.text-caption; horizontal-alignment: right; vertical-alignment: top; overflow: elide; }
    Text { x: 12px + root.model-column-width + 2 * root.group-gap + root.group-width; y: 28px; width: root.group-width - root.dollar-width; height: 66px;
        visible: root.has-data; text: root.cached-token-rows; color: DesignTokens.main-text-primary;
        font-size: DesignTokens.text-caption; horizontal-alignment: right; vertical-alignment: top; overflow: elide; }
    Text { x: 12px + root.model-column-width + 2 * root.group-gap + 2 * root.group-width - root.dollar-width; y: 28px; width: root.dollar-width; height: 66px;
        visible: root.has-data; text: root.cached-cost-rows; color: DesignTokens.main-text-primary;
        font-size: DesignTokens.text-caption; horizontal-alignment: right; vertical-alignment: top; overflow: elide; }
    Text { x: 12px + root.model-column-width + 3 * root.group-gap + 2 * root.group-width; y: 28px; width: root.group-width - root.dollar-width; height: 66px;
        visible: root.has-data; text: root.output-token-rows; color: DesignTokens.main-text-primary;
        font-size: DesignTokens.text-caption; horizontal-alignment: right; vertical-alignment: top; overflow: elide; }
    Text { x: 12px + root.model-column-width + 3 * root.group-gap + 3 * root.group-width - root.dollar-width; y: 28px; width: root.dollar-width; height: 66px;
        visible: root.has-data; text: root.output-cost-rows; color: DesignTokens.main-text-primary;
        font-size: DesignTokens.text-caption; horizontal-alignment: right; vertical-alignment: top; overflow: elide; }
    if !root.has-data : Text {
        x: 12px;
        y: 28px;
        width: parent.width - 24px;
        height: 66px;
        text: root.strings.no-records;
        color: DesignTokens.main-label;
        font-size: 12px;
        vertical-alignment: center;
    }
}

export component StatusBanner inherits Rectangle {
    in property <UiStrings> strings;
    in property <string> title;
    in property <string> detail;
    in property <string> last-received;
    in property <string> level: "info";
    in property <bool> show-action: false;
    in property <string> action-text;
    in property <bool> action-enabled: true;
    callback action();
    private property <length> action-width: root.action-text == root.strings.retry ? 92px : 112px;
    height: 42px;
    border-radius: 8px;
    border-width: 1px;
    border-color: level == "error" ? DesignTokens.main-status-error-border :
        level == "warning" ? DesignTokens.main-status-warning-border : DesignTokens.main-status-normal-border;
    background: level == "error" ? DesignTokens.main-status-error-background :
        level == "warning" ? DesignTokens.main-status-warning-background : DesignTokens.main-status-normal-background;

    Rectangle {
        x: 10px;
        y: 17px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: level == "error" ? DesignTokens.main-status-error-accent :
            level == "warning" ? DesignTokens.main-status-warning-accent : DesignTokens.main-status-normal-accent;
    }
    Text {
        x: 28px;
        y: 3px;
        width: root.show-action ? parent.width - root.action-width - 48px : parent.width - 250px;
        height: 17px;
        text: root.title;
        color: DesignTokens.main-text-primary;
        font-weight: 700;
        font-size: DesignTokens.text-caption;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 28px;
        y: 20px;
        width: root.show-action ? parent.width - root.action-width - 48px : parent.width - 40px;
        height: 18px;
        text: root.detail;
        color: DesignTokens.main-label;
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - 222px;
        y: 3px;
        width: 210px;
        height: 17px;
        text: root.last-received;
        visible: !root.show-action;
        color: DesignTokens.main-label;
        font-size: 11px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
    ActionButton {
        x: parent.width - root.action-width - 8px;
        y: 7px;
        width: root.action-width;
        height: 28px;
        text: root.action-text;
        visible: root.show-action;
        enabled: root.action-enabled;
        primary: false;
        refresh-style: true;
        clicked => { root.action(); }
    }
}

export component TimeZoneSettingsWindow inherits Window {
    preferred-width: 440px;
    preferred-height: 220px;
    min-width: 440px;
    max-width: 440px;
    min-height: 220px;
    max-height: 220px;
    in-out property <string> window-title;
    in property <UiStrings> strings;
    in property <[string]> time-zone-options;
    in-out property <string> selected-time-zone: "local";
    in-out property <string> save-error;
    in-out property <bool> reset-close-buttons: false;
    callback save-time-zone(string);
    callback cancel-settings();
    callback begin-window-drag();
    callback minimize-window();
    callback close-window();
    no-frame: true;
    resize-border-width: 0px;
    title: root.window-title;
    background: DesignTokens.canvas;
    default-font-family: root.strings.font-family;

    Rectangle {
        x: 22px;
        y: 18px;
        width: parent.width - 44px;
        height: parent.height - 36px;
        border-radius: DesignTokens.radius-surface;
        background: DesignTokens.raised;
        WindowDragArea {
            x: 0px; y: 0px; width: parent.width - 72px; height: 46px;
            begin-drag => { root.begin-window-drag(); }
        }
        Text {
            x: 18px; y: 10px; width: parent.width - 108px; height: 30px;
            text: root.strings.settings; color: DesignTokens.text-primary;
            font-size: 20px; font-weight: 700; vertical-alignment: center;
        }
        WindowControls {
            x: parent.width - 72px; y: 9px; show-maximize: false;
            minimize => { root.minimize-window(); }
            close => { root.cancel-settings(); }
        }
        Text {
            x: 18px; y: 57px; width: 112px; height: 36px;
            text: root.strings.time-zone; color: DesignTokens.text-secondary;
            font-size: DesignTokens.text-body; vertical-alignment: center;
        }
        GraphSelect {
            x: 132px; y: 57px; width: parent.width - 150px; height: 36px;
            model: root.time-zone-options;
            empty-label: "local";
            current-index: root.selected-time-zone == "UTC" ? 1 : 0;
            selected(value) => { root.selected-time-zone = value; }
        }
        Text {
            x: 18px; y: 98px; width: parent.width - 36px; height: 24px;
            text: root.save-error; visible: root.save-error != "";
            color: DesignTokens.danger; font-size: 11px; vertical-alignment: center;
            overflow: elide;
        }
        ActionButton {
            x: parent.width - 206px; y: 132px; width: 88px; height: 34px;
            text: root.strings.cancel;
            clicked => { root.cancel-settings(); }
        }
        ActionButton {
            x: parent.width - 108px; y: 132px; width: 90px; height: 34px;
            text: root.strings.save; primary: true;
            clicked => { root.save-time-zone(root.selected-time-zone); }
        }
    }
}

component GraphToggle inherits Rectangle {
    in property <string> label;
    in property <color> series-color;
    in-out property <bool> checked: true;
    callback toggled();
    width: 96px;
    height: 24px;
    background: transparent;

    Rectangle {
        x: 8px;
        y: 9px;
        width: 14px;
        height: 4px;
        border-radius: 2px;
        background: root.series-color;
        opacity: root.checked ? 1 : 0.35;
    }
    Text {
        x: 28px;
        width: parent.width - 32px;
        height: parent.height;
        // Series state is represented by color and label contrast.
        text: root.label;
        color: root.checked ? DesignTokens.text-primary : DesignTokens.text-muted;
        font-size: 10px;
        vertical-alignment: center;
        overflow: elide;
    }
    TouchArea {
        clicked => { root.toggled(); }
    }
}

export struct RemainingMarker {
    x: float,
    y: float,
}

export struct GraphUnusedInterval {
    start: float,
    width: float,
}

// Pathの座標は0〜100のviewboxで受け取る。Rust側が各系列の
// SVG path commandsと、同じ受理済み表示証拠からhas-graph-dataを生成する。
export component GraphWindow inherits Window {
    preferred-width: 940px;
    preferred-height: 640px;
    min-width: 700px;
    min-height: 480px;
    in-out property <string> window-title;
    in property <UiStrings> strings;
    in property <bool> has-history-options: true;
    in property <bool> history-loading: false;
    in property <bool> history-load-error: false;
    in-out property <bool> reset-close-buttons: false;
    no-frame: true;
    // Slint supplies edge resize hit-testing for frameless winit windows.
    // Keep this enabled so Graph retains the resize behavior requested by
    // the user while the other fixed-size windows remain non-resizable.
    resize-border-width: 6px;
    title: root.window-title;
    background: DesignTokens.canvas;
    default-font-family: root.strings.font-family;

    in property <bool> has-graph-data: false;
    in-out property <[GraphUnusedInterval]> unused-intervals;
    in-out property <bool> show-remaining: true;
    in-out property <bool> show-luna: true;
    in-out property <bool> show-terra: true;
    in-out property <bool> show-sol: true;
    in-out property <bool> show-astra: true;
    // Graph uses app-side monitor geometry for maximize/restore. Keeping the
    // visual state separate from Window.maximized avoids asking X11 to size
    // the frameless surface to WSLg's virtual desktop root.
    in-out property <bool> app-maximized: false;
    in-out property <bool> show-tokens: false;
    in-out property <string> remaining-path;
    in-out property <string> remaining-idle-path;
    in-out property <string> remaining-inferred-path;
    in-out property <[RemainingMarker]> remaining-markers;
    in-out property <string> sol-idle-path;
    in-out property <string> sol-flat-path;
    in-out property <string> sol-rising-path;
    in-out property <string> sol-inferred-path;
    in-out property <string> terra-idle-path;
    in-out property <string> terra-flat-path;
    in-out property <string> terra-rising-path;
    in-out property <string> terra-inferred-path;
    in-out property <string> luna-idle-path;
    in-out property <string> luna-flat-path;
    in-out property <string> luna-rising-path;
    in-out property <string> luna-inferred-path;
    in-out property <string> astra-idle-path;
    in-out property <string> astra-flat-path;
    in-out property <string> astra-rising-path;
    in-out property <string> astra-inferred-path;
    in property <[string]> history-period-options;
    in property <bool> open-history-on-start: false;
    in property <int> selected-history-index: 0;
    in property <[string]> account-options;
    in property <int> selected-account-index: 0;
    in property <[string]> metric-options;
    in property <int> selected-metric-index: 0;
    out property <bool> history-popup-open: history-select.popup-open;
    in-out property <string> time-start-label;
    in-out property <string> time-25-label;
    in-out property <string> time-50-label;
    in-out property <string> time-75-label;
    in-out property <string> time-end-label;
    in-out property <string> dollar-top-label;
    in-out property <string> dollar-75-label;
    in-out property <string> dollar-50-label;
    in-out property <string> dollar-25-label;
    in-out property <string> dollar-bottom-label;
    in-out property <string> current-remaining-label;
    in-out property <string> current-sol-label;
    in-out property <string> current-terra-label;
    in-out property <string> current-luna-label;
    in-out property <string> current-astra-label;
    in-out property <string> current-remaining-connector-path;
    in-out property <string> current-sol-connector-path;
    in-out property <string> current-terra-connector-path;
    in-out property <string> current-luna-connector-path;
    in-out property <string> current-astra-connector-path;
    in-out property <float> current-remaining-y;
    in-out property <float> current-sol-y;
    in-out property <float> current-terra-y;
    in-out property <float> current-luna-y;
    in-out property <float> current-astra-y;
    callback close-graph();
    callback begin-window-drag();
    callback begin-window-resize(string);
    callback minimize-window();
    callback toggle-maximize-window();
    callback close-window();
    callback select-history(string);
    callback select-account(string);
    callback select-metric(string);
    callback toggle-remaining();
    callback toggle-luna();
    callback toggle-terra();
    callback toggle-sol();
    callback toggle-astra();
    private property <length> content-x: min(30px, max(20px, 20px + (root.width - 700px) / 24));
    private property <length> content-width: root.width - 2 * root.content-x;
    private property <length> plot-left: 92px;
    private property <length> current-label-gap: 10px;
    private property <length> current-label-width: root.show-tokens ? 112px : 80px;
    private property <length> current-label-right-padding: 4px;
    private property <length> plot-width: root.content-width - root.plot-left - root.current-label-gap - root.current-label-width - root.current-label-right-padding;
    private property <length> current-label-x: root.plot-left + root.plot-width + root.current-label-gap;
    // The history popup is an overlay. Keep the toggles and plot geometry
    // fixed so opening the list never reflows or shrinks the graph.
    private property <length> history-toggle-y: 144px;

    // A frameless surface must paint every pixel explicitly; otherwise an
    // underlying window can show through the margins around the graph.
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: DesignTokens.canvas;
        z: -10;
    }
    WindowDragArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        z: -5;
        begin-drag => { root.begin-window-drag(); }
    }

    Rectangle {
        x: root.content-x;
        y: 24px;
        width: root.content-width;
        height: root.height - 48px;

        // Paint the frameless title strip explicitly. This also prevents a
        // compositor from exposing an uninitialized transparent surface while
        // the custom drag region is idle.
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 36px;
            background: DesignTokens.canvas;
            z: -2;
        }
        WindowDragArea {
            x: 0px;
            y: 0px;
            width: parent.width - 252px;
            height: 36px;
            begin-drag => { root.begin-window-drag(); }
        }
        Text {
            x: 0px;
            y: 0px;
            width: parent.width - 252px;
            height: 36px;
            text: root.strings.usage-trend;
            color: DesignTokens.text-primary;
            font-size: 24px;
            font-weight: 700;
            vertical-alignment: center;
        }
        WindowControls {
            x: parent.width - 108px;
            y: 4px;
            show-maximize: true;
            maximized: root.app-maximized;
            minimize => { root.minimize-window(); }
            toggle-maximize => { root.toggle-maximize-window(); }
            close => { root.close-window(); }
        }
        GraphSelect {
            x: 0px;
            y: 42px;
            width: parent.width;
            height: 36px;
            model: root.account-options;
            empty-label: "アカウントなし";
            field-label: root.strings.account-selector-heading;
            current-index: root.selected-account-index;
            popup-width: 560px;
            z: 2;
            selected(value) => { root.select-account(value); }
        }
        GraphSelect {
            x: parent.width - 244px;
            y: 0px;
            width: 128px;
            height: 36px;
            model: root.metric-options;
            empty-label: root.strings.no-history;
            current-index: root.selected-metric-index;
            popup-above: true;
            popup-x: -128px;
            selected(value) => { root.select-metric(value); }
        }
        Rectangle {
            x: 0px;
            y: 42px;
            width: parent.width;
            height: root.history-toggle-y + 32px - 42px;
            background: DesignTokens.graph-control-surface;
            opacity: 0.72;
            z: -1;
        }
        history-select := GraphSelect {
            x: 0px;
            y: 84px;
            width: parent.width;
            height: 36px;
            model: root.history-period-options;
            empty-label: root.history-loading ? root.strings.graph-loading : root.strings.no-history;
            field-label: root.strings.period-selector-heading;
            selectable: root.has-history-options;
            current-index: root.selected-history-index;
            open-on-start: root.open-history-on-start;
            // Open below the selector so the bounded popup overlays the
            // controls and plot instead of changing their geometry.
            popup-above: false;
            // Period labels are short. Keeping the popup compact puts its
            // scroll controls beside the text instead of at the far edge of
            // a maximized graph, while ten rows avoid needless paging.
            popup-width: min(620px, parent.width);
            max-visible-items: 10;
            z: 2;
            selected(value) => { root.select-history(value); }
        }

        GraphToggle { x: 0px; y: root.history-toggle-y; width: 96px; label: root.strings.remaining; series-color: DesignTokens.graph-remaining; checked: root.show-remaining; toggled => { root.toggle-remaining(); } }
        GraphToggle { x: 102px; y: root.history-toggle-y; width: 96px; label: "LUNA"; series-color: DesignTokens.graph-luna; checked: root.show-luna; toggled => { root.toggle-luna(); } }
        GraphToggle { x: 204px; y: root.history-toggle-y; width: 96px; label: "TERRA"; series-color: DesignTokens.graph-terra; checked: root.show-terra; toggled => { root.toggle-terra(); } }
        GraphToggle { x: 306px; y: root.history-toggle-y; width: 96px; label: "SOL"; series-color: DesignTokens.graph-sol; checked: root.show-sol; toggled => { root.toggle-sol(); } }
        GraphToggle { x: 408px; y: root.history-toggle-y; width: 96px; label: "ASTRA"; series-color: DesignTokens.graph-astra; checked: root.show-astra; toggled => { root.toggle-astra(); } }

        Rectangle {
            x: 0px;
            y: root.history-toggle-y + 32px;
            width: parent.width;
            // The plot stays in the same place while the history popup
            // overlays its upper edge.
            height: parent.height - root.history-toggle-y - 32px;
            border-radius: DesignTokens.radius-surface;
            border-width: 1px;
            border-color: DesignTokens.graph-plot-border;
            background: DesignTokens.graph-plot-surface;
            clip: true;

            Text { x: 0px; y: 18px; width: 84px; height: 16px; text: root.dollar-top-label; color: DesignTokens.text-muted; font-size: DesignTokens.text-caption; horizontal-alignment: right; }
            Text { x: 0px; y: parent.height * 0.25 + 16px; width: 84px; height: 16px; text: root.dollar-75-label; color: DesignTokens.text-muted; font-size: DesignTokens.text-caption; horizontal-alignment: right; }
            Text { x: 0px; y: parent.height * 0.50 + 4px; width: 84px; height: 16px; text: root.dollar-50-label; color: DesignTokens.text-muted; font-size: DesignTokens.text-caption; horizontal-alignment: right; }
            Text { x: 0px; y: parent.height * 0.75 - 8px; width: 84px; height: 16px; text: root.dollar-25-label; color: DesignTokens.text-muted; font-size: DesignTokens.text-caption; horizontal-alignment: right; }
            Text { x: 0px; y: parent.height - 32px; width: 84px; height: 16px; text: root.dollar-bottom-label; color: DesignTokens.text-muted; font-size: DesignTokens.text-caption; horizontal-alignment: right; }
            Text { x: root.plot-left; y: 6px; width: root.plot-width; height: 16px; text: root.show-tokens ? root.strings.graph-token-description : root.strings.graph-dollar-description; color: DesignTokens.text-muted; font-size: DesignTokens.text-caption; overflow: elide; }

            Rectangle { x: root.plot-left; y: 28px; width: root.plot-width; height: 1px; background: DesignTokens.chart-grid; }
            Rectangle { x: root.plot-left; y: parent.height * 0.25 + 24px; width: root.plot-width; height: 1px; background: DesignTokens.chart-grid; }
            Rectangle { x: root.plot-left; y: parent.height * 0.50 + 12px; width: root.plot-width; height: 1px; background: DesignTokens.chart-grid; }
            Rectangle { x: root.plot-left; y: parent.height * 0.75; width: root.plot-width; height: 1px; background: DesignTokens.chart-grid; }
            Rectangle { x: root.plot-left; y: parent.height - 24px; width: root.plot-width; height: 1px; background: DesignTokens.chart-grid; }
            Rectangle { x: root.plot-left; y: 28px; width: 1px; height: parent.height - 52px; background: DesignTokens.chart-grid; }
            Rectangle { x: root.plot-left + root.plot-width * 0.25; y: 28px; width: 1px; height: parent.height - 52px; background: DesignTokens.chart-grid; }
            Rectangle { x: root.plot-left + root.plot-width * 0.50; y: 28px; width: 1px; height: parent.height - 52px; background: DesignTokens.chart-grid; }
            Rectangle { x: root.plot-left + root.plot-width * 0.75; y: 28px; width: 1px; height: parent.height - 52px; background: DesignTokens.chart-grid; }
            Rectangle { x: root.plot-left + root.plot-width; y: 28px; width: 1px; height: parent.height - 52px; background: DesignTokens.chart-grid; }

            // Idle evidence is an opaque final surface above the grid and
            // below every data path. Its geometry is never pixel-filtered.
            for interval in root.unused-intervals: Rectangle {
                x: root.plot-left + root.plot-width * interval.start / 100;
                y: 28px;
                width: root.plot-width * interval.width / 100;
                height: parent.height - 52px;
                background: DesignTokens.graph-idle-band;
                visible: root.has-graph-data && interval.width > 0.0;
            }

            // Rust emits leader coordinates in the same 0..100 viewbox as the
            // series. Fit each short path to the label gap and plot height;
            // without this, the normalized values become raw pixels and stray
            // lines appear near the middle/top instead of reaching the label.
            Path {
                x: root.plot-left + root.plot-width;
                y: 28px;
                width: root.current-label-gap;
                height: parent.height - 52px;
                viewbox-width: 100;
                viewbox-height: 100;
                fit: fill;
                commands: root.current-remaining-connector-path;
                visible: root.current-remaining-connector-path != "" && root.show-remaining;
                stroke: DesignTokens.graph-remaining;
                stroke-width: 1px;
                fill: transparent;
                opacity: 0.8;
                stroke-line-cap: round;
            }
            Path {
                x: root.plot-left + root.plot-width;
                y: 28px;
                width: root.current-label-gap;
                height: parent.height - 52px;
                viewbox-width: 100;
                viewbox-height: 100;
                fit: fill;
                commands: root.current-astra-connector-path;
                visible: root.current-astra-connector-path != "" && root.show-astra;
                stroke: DesignTokens.graph-astra;
                stroke-width: 1px;
                fill: transparent;
                opacity: 0.8;
                stroke-line-cap: round;
            }
            Path {
                x: root.plot-left + root.plot-width;
                y: 28px;
                width: root.current-label-gap;
                height: parent.height - 52px;
                viewbox-width: 100;
                viewbox-height: 100;
                fit: fill;
                commands: root.current-sol-connector-path;
                visible: root.current-sol-connector-path != "" && root.show-sol;
                stroke: DesignTokens.graph-sol;
                stroke-width: 1px;
                fill: transparent;
                opacity: 0.8;
                stroke-line-cap: round;
            }
            Path {
                x: root.plot-left + root.plot-width;
                y: 28px;
                width: root.current-label-gap;
                height: parent.height - 52px;
                viewbox-width: 100;
                viewbox-height: 100;
                fit: fill;
                commands: root.current-terra-connector-path;
                visible: root.current-terra-connector-path != "" && root.show-terra;
                stroke: DesignTokens.graph-terra;
                stroke-width: 1px;
                fill: transparent;
                opacity: 0.8;
                stroke-line-cap: round;
            }
            Path {
                x: root.plot-left + root.plot-width;
                y: 28px;
                width: root.current-label-gap;
                height: parent.height - 52px;
                viewbox-width: 100;
                viewbox-height: 100;
                fit: fill;
                commands: root.current-luna-connector-path;
                visible: root.current-luna-connector-path != "" && root.show-luna;
                stroke: DesignTokens.graph-luna;
                stroke-width: 1px;
                fill: transparent;
                opacity: 0.8;
                stroke-line-cap: round;
            }

            Text { x: root.current-label-x; y: 28px + root.current-remaining-y * (parent.height - 52px) - 8px; width: root.current-label-width; height: 16px; text: root.current-remaining-label; visible: root.current-remaining-label != "" && root.show-remaining; color: DesignTokens.graph-remaining; font-size: 10px; font-weight: 700; horizontal-alignment: left; }
            Text { x: root.current-label-x; y: 28px + root.current-luna-y * (parent.height - 52px) - 8px; width: root.current-label-width; height: 16px; text: root.current-luna-label; visible: root.current-luna-label != "" && root.show-luna; color: DesignTokens.graph-luna; font-size: 10px; font-weight: 700; horizontal-alignment: left; }
            Text { x: root.current-label-x; y: 28px + root.current-terra-y * (parent.height - 52px) - 8px; width: root.current-label-width; height: 16px; text: root.current-terra-label; visible: root.current-terra-label != "" && root.show-terra; color: DesignTokens.graph-terra; font-size: 10px; font-weight: 700; horizontal-alignment: left; }
            Text { x: root.current-label-x; y: 28px + root.current-sol-y * (parent.height - 52px) - 8px; width: root.current-label-width; height: 16px; text: root.current-sol-label; visible: root.current-sol-label != "" && root.show-sol; color: DesignTokens.graph-sol; font-size: 10px; font-weight: 700; horizontal-alignment: left; }
            Text { x: root.current-label-x; y: 28px + root.current-astra-y * (parent.height - 52px) - 8px; width: root.current-label-width; height: 16px; text: root.current-astra-label; visible: root.current-astra-label != "" && root.show-astra; color: DesignTokens.graph-astra; font-size: 10px; font-weight: 700; horizontal-alignment: left; }

            // Missing-interval bridges are weaker evidence than measured
            // samples. Keep them visibly thinner than every observed path.
            Path {
                x: root.plot-left; y: 28px; width: root.plot-width; height: parent.height - 52px;
                viewbox-width: 100; viewbox-height: 100; fit: fill; clip: true;
                commands: root.luna-inferred-path; visible: root.show-luna;
                stroke: DesignTokens.graph-luna; stroke-width: 1px; fill: transparent; opacity: 0.72;
                stroke-line-cap: round; stroke-line-join: round;
            }
            Path {
                x: root.plot-left; y: 28px; width: root.plot-width; height: parent.height - 52px;
                viewbox-width: 100; viewbox-height: 100; fit: fill; clip: true;
                commands: root.terra-inferred-path; visible: root.show-terra;
                stroke: DesignTokens.graph-terra; stroke-width: 1px; fill: transparent; opacity: 0.72;
                stroke-line-cap: round; stroke-line-join: round;
            }
            Path {
                x: root.plot-left; y: 28px; width: root.plot-width; height: parent.height - 52px;
                viewbox-width: 100; viewbox-height: 100; fit: fill; clip: true;
                commands: root.sol-inferred-path; visible: root.show-sol;
                stroke: DesignTokens.graph-sol; stroke-width: 1px; fill: transparent; opacity: 0.72;
                stroke-line-cap: round; stroke-line-join: round;
            }
            Path {
                x: root.plot-left; y: 28px; width: root.plot-width; height: parent.height - 52px;
                viewbox-width: 100; viewbox-height: 100; fit: fill; clip: true;
                commands: root.astra-inferred-path; visible: root.show-astra;
                stroke: DesignTokens.graph-astra; stroke-width: 1px; fill: transparent; opacity: 0.72;
                stroke-line-cap: round; stroke-line-join: round;
            }
            // Confirmed sustained non-use is the only thin solid state. The
            // background band and all five horizontal paths share intervals.
            Path {
                x: root.plot-left; y: 28px; width: root.plot-width; height: parent.height - 52px;
                viewbox-width: 100; viewbox-height: 100; fit: fill; clip: true;
                commands: root.luna-idle-path; visible: root.show-luna;
                stroke: DesignTokens.graph-luna; stroke-width: 1px; fill: transparent; opacity: 0.95;
                stroke-line-cap: round; stroke-line-join: round;
            }
            Path {
                x: root.plot-left; y: 28px; width: root.plot-width; height: parent.height - 52px;
                viewbox-width: 100; viewbox-height: 100; fit: fill; clip: true;
                commands: root.terra-idle-path; visible: root.show-terra;
                stroke: DesignTokens.graph-terra; stroke-width: 1px; fill: transparent; opacity: 0.95;
                stroke-line-cap: round; stroke-line-join: round;
            }
            Path {
                x: root.plot-left; y: 28px; width: root.plot-width; height: parent.height - 52px;
                viewbox-width: 100; viewbox-height: 100; fit: fill; clip: true;
                commands: root.sol-idle-path; visible: root.show-sol;
                stroke: DesignTokens.graph-sol; stroke-width: 1px; fill: transparent; opacity: 0.95;
                stroke-line-cap: round; stroke-line-join: round;
            }
            Path {
                x: root.plot-left; y: 28px; width: root.plot-width; height: parent.height - 52px;
                viewbox-width: 100; viewbox-height: 100; fit: fill; clip: true;
                commands: root.astra-idle-path; visible: root.show-astra;
                stroke: DesignTokens.graph-astra; stroke-width: 1px; fill: transparent; opacity: 0.95;
                stroke-line-cap: round; stroke-line-join: round;
            }
            Path {
                x: root.plot-left;
                y: 28px;
                width: root.plot-width;
                height: parent.height - 52px;
                viewbox-width: 100;
                viewbox-height: 100;
                fit: fill;
                clip: true;
                commands: root.luna-flat-path;
                visible: root.show-luna;
                stroke: DesignTokens.graph-luna;
                // Every valid measured interval uses one uniform solid width.
                // Only prediction intervals use the thin dashed treatment.
                stroke-width: 3px;
                fill: transparent;
                opacity: 0.95;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
            Path {
                x: root.plot-left;
                y: 28px;
                width: root.plot-width;
                height: parent.height - 52px;
                viewbox-width: 100;
                viewbox-height: 100;
                fit: fill;
                clip: true;
                commands: root.astra-flat-path;
                visible: root.show-astra;
                stroke: DesignTokens.graph-astra;
                stroke-width: 3px;
                fill: transparent;
                opacity: 0.95;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
            Path {
                x: root.plot-left;
                y: 28px;
                width: root.plot-width;
                height: parent.height - 52px;
                viewbox-width: 100;
                viewbox-height: 100;
                fit: fill;
                clip: true;
                commands: root.astra-rising-path;
                visible: root.show-astra;
                stroke: DesignTokens.graph-astra;
                stroke-width: 3px;
                fill: transparent;
                opacity: 0.95;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
            Path {
                x: root.plot-left;
                y: 28px;
                width: root.plot-width;
                height: parent.height - 52px;
                viewbox-width: 100;
                viewbox-height: 100;
                fit: fill;
                clip: true;
                commands: root.luna-rising-path;
                visible: root.show-luna;
                stroke: DesignTokens.graph-luna;
                stroke-width: 3px;
                fill: transparent;
                opacity: 0.95;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
            Path {
                x: root.plot-left;
                y: 28px;
                width: root.plot-width;
                height: parent.height - 52px;
                viewbox-width: 100;
                viewbox-height: 100;
                fit: fill;
                clip: true;
                commands: root.terra-flat-path;
                visible: root.show-terra;
                stroke: DesignTokens.graph-terra;
                // Exact flat observations are confirmed non-use, with the
                // same solid width as every changing measured interval.
                stroke-width: 3px;
                fill: transparent;
                opacity: 0.95;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
            Path {
                x: root.plot-left;
                y: 28px;
                width: root.plot-width;
                height: parent.height - 52px;
                viewbox-width: 100;
                viewbox-height: 100;
                fit: fill;
                clip: true;
                commands: root.terra-rising-path;
                visible: root.show-terra;
                stroke: DesignTokens.graph-terra;
                stroke-width: 3px;
                fill: transparent;
                opacity: 0.95;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
            Path {
                x: root.plot-left;
                y: 28px;
                width: root.plot-width;
                height: parent.height - 52px;
                viewbox-width: 100;
                viewbox-height: 100;
                fit: fill;
                clip: true;
                commands: root.sol-flat-path;
                visible: root.show-sol;
                stroke: DesignTokens.graph-sol;
                // Exact flat observations are confirmed non-use, with the
                // same solid width as every changing measured interval.
                stroke-width: 3px;
                fill: transparent;
                opacity: 0.95;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
            Path {
                x: root.plot-left;
                y: 28px;
                width: root.plot-width;
                height: parent.height - 52px;
                viewbox-width: 100;
                viewbox-height: 100;
                fit: fill;
                clip: true;
                commands: root.sol-rising-path;
                visible: root.show-sol;
                stroke: DesignTokens.graph-sol;
                stroke-width: 3px;
                fill: transparent;
                opacity: 0.95;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
            Path {
                x: root.plot-left;
                y: 28px;
                width: root.plot-width;
                height: parent.height - 52px;
                viewbox-width: 100;
                viewbox-height: 100;
                fit: fill;
                clip: true;
                commands: root.remaining-inferred-path;
                visible: root.show-remaining;
                stroke: DesignTokens.graph-remaining;
                stroke-width: 1px;
                fill: transparent;
                opacity: 0.72;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
            Path {
                x: root.plot-left;
                y: 28px;
                width: root.plot-width;
                height: parent.height - 52px;
                viewbox-width: 100;
                viewbox-height: 100;
                fit: fill;
                clip: true;
                commands: root.remaining-idle-path;
                visible: root.show-remaining;
                stroke: DesignTokens.graph-remaining;
                stroke-width: 1px;
                fill: transparent;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
            for marker in root.remaining-markers: Rectangle {
                x: root.plot-left + root.plot-width * marker.x / 100 - 1px;
                y: 28px + (parent.height - 52px) * marker.y / 100 - 1px;
                width: 2px;
                height: 2px;
                border-radius: 1px;
                background: DesignTokens.graph-remaining;
                visible: root.show-remaining;
            }
            // Draw the continuous stroke after the boundary markers so marker
            // squares cannot make a straight sampling interval look stepped.
            Path {
                x: root.plot-left;
                y: 28px;
                width: root.plot-width;
                height: parent.height - 52px;
                viewbox-width: 100;
                viewbox-height: 100;
                fit: fill;
                clip: true;
                commands: root.remaining-path;
                visible: root.show-remaining;
                stroke: DesignTokens.graph-remaining;
                stroke-width: 3px;
                fill: transparent;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
            Text { x: root.plot-left; y: parent.height - 22px; width: 96px; height: 16px; text: root.time-start-label; color: DesignTokens.text-muted; font-size: 10px; horizontal-alignment: left; }
            Text { x: root.plot-left + root.plot-width * 0.25 - 48px; y: parent.height - 22px; width: 96px; height: 16px; text: root.time-25-label; color: DesignTokens.text-muted; font-size: 10px; horizontal-alignment: center; }
            Text { x: root.plot-left + root.plot-width * 0.50 - 48px; y: parent.height - 22px; width: 96px; height: 16px; text: root.time-50-label; color: DesignTokens.text-muted; font-size: 10px; horizontal-alignment: center; }
            Text { x: root.plot-left + root.plot-width * 0.75 - 48px; y: parent.height - 22px; width: 96px; height: 16px; text: root.time-75-label; color: DesignTokens.text-muted; font-size: 10px; horizontal-alignment: center; }
            Text { x: root.plot-left + root.plot-width - 96px; y: parent.height - 22px; width: 96px; height: 16px; text: root.time-end-label; color: DesignTokens.text-muted; font-size: 10px; horizontal-alignment: right; }
            Rectangle {
                x: root.plot-left;
                y: 28px;
                width: root.plot-width;
                height: parent.height - 52px;
                visible: !root.has-graph-data && !root.history-loading && !root.history-load-error;
                background: DesignTokens.raised;
                Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: root.strings.no-records;
                    color: DesignTokens.text-secondary;
                    font-size: DesignTokens.text-reset;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if root.history-loading : Rectangle {
                x: root.plot-left;
                y: 28px;
                width: root.plot-width;
                height: parent.height - 52px;
                background: DesignTokens.raised;
                Spinner {
                    x: parent.width / 2 - 12px;
                    y: parent.height / 2 - 30px;
                    width: 24px;
                    height: 24px;
                    indeterminate: true;
                }
                Text {
                    x: 0px;
                    y: parent.height / 2 + 2px;
                    width: parent.width;
                    height: 24px;
                    text: root.strings.graph-loading;
                    color: DesignTokens.text-secondary;
                    font-size: DesignTokens.text-reset;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                x: root.plot-left;
                y: 28px;
                width: root.plot-width;
                height: parent.height - 52px;
                visible: !root.has-graph-data && !root.history-loading && root.history-load-error;
                background: DesignTokens.raised;
                Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: root.strings.graph-load-error;
                    color: DesignTokens.text-secondary;
                    font-size: DesignTokens.text-reset;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Keep resize hit areas above the graph content. Slint's built-in
    // frameless hit testing remains enabled, while these explicit handles
    // cover compositors that report a hidden frame as decorated.
    WindowResizeHandle {
        z: 20;
        x: 14px;
        y: 0px;
        width: root.width - 28px;
        height: 14px;
        direction: "north";
        resize-cursor: MouseCursor.ns-resize;
        begin-resize(direction) => { root.begin-window-resize(direction); }
    }
    WindowResizeHandle {
        z: 20;
        x: 14px;
        y: root.height - 14px;
        width: root.width - 28px;
        height: 14px;
        direction: "south";
        resize-cursor: MouseCursor.ns-resize;
        begin-resize(direction) => { root.begin-window-resize(direction); }
    }
    WindowResizeHandle {
        z: 20;
        x: 0px;
        y: 14px;
        width: 14px;
        height: root.height - 28px;
        direction: "west";
        resize-cursor: MouseCursor.ew-resize;
        begin-resize(direction) => { root.begin-window-resize(direction); }
    }
    WindowResizeHandle {
        z: 20;
        x: root.width - 14px;
        y: 14px;
        width: 14px;
        height: root.height - 28px;
        direction: "east";
        resize-cursor: MouseCursor.ew-resize;
        begin-resize(direction) => { root.begin-window-resize(direction); }
    }
    WindowResizeHandle {
        z: 30;
        x: 0px;
        y: 0px;
        width: 28px;
        height: 28px;
        direction: "north-west";
        resize-cursor: MouseCursor.nwse-resize;
        corner: true;
        begin-resize(direction) => { root.begin-window-resize(direction); }
    }
    WindowResizeHandle {
        z: 30;
        x: root.width - 28px;
        y: 0px;
        width: 28px;
        height: 28px;
        direction: "north-east";
        resize-cursor: MouseCursor.nesw-resize;
        corner: true;
        begin-resize(direction) => { root.begin-window-resize(direction); }
    }
    WindowResizeHandle {
        z: 30;
        x: 0px;
        y: root.height - 28px;
        width: 28px;
        height: 28px;
        direction: "south-west";
        resize-cursor: MouseCursor.nesw-resize;
        corner: true;
        begin-resize(direction) => { root.begin-window-resize(direction); }
    }
    WindowResizeHandle {
        z: 30;
        x: root.width - 28px;
        y: root.height - 28px;
        width: 28px;
        height: 28px;
        direction: "south-east";
        resize-cursor: MouseCursor.nwse-resize;
        corner: true;
        begin-resize(direction) => { root.begin-window-resize(direction); }
    }
}

export component AuthPanel inherits Rectangle {
    in property <UiStrings> strings;
    in property <bool> has-auth-url;
    in property <bool> checking;
    in property <string> status;
    in property <bool> has-error;
    in property <bool> service-unavailable;
    callback begin-auth();
    callback check-auth();
    callback retry();
    height: 232px;
    border-radius: DesignTokens.radius-surface;
    border-width: 1px;
    border-color: DesignTokens.border-subtle;
    background: DesignTokens.raised;

    Text {
        x: 24px;
        y: 18px;
        width: parent.width - 48px;
        height: 30px;
        text: root.strings.connect-account;
        color: DesignTokens.text-primary;
        font-size: 22px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 24px;
        y: 56px;
        width: parent.width - 48px;
        height: 36px;
        text: has-auth-url ?
            root.strings.auth-browser-instructions :
            root.strings.auth-managed;
        color: DesignTokens.text-secondary;
        font-size: DesignTokens.text-body;
        overflow: elide;
    }
    ActionButton {
        x: 24px;
        y: 100px;
        width: 168px;
        text: root.service-unavailable ? root.strings.retry :
            has-auth-url ? root.strings.open-auth-page : root.strings.start-auth;
        enabled: !checking;
        primary: true;
        clicked => {
            if (root.service-unavailable) {
                root.retry();
            } else {
                root.begin-auth();
            }
        }
    }
    ActionButton {
        x: 204px;
        y: 100px;
        width: 154px;
        text: checking ? root.strings.checking : root.strings.check-auth;
        visible: !root.service-unavailable;
        enabled: !checking;
        primary: false;
        clicked => { root.check-auth(); }
    }
    Text {
        x: 24px;
        y: 148px;
        width: parent.width - 48px;
        height: 22px;
        text: status;
        color: has-error ? DesignTokens.danger : DesignTokens.accent-primary;
        font-size: DesignTokens.text-caption;
        overflow: elide;
    }
    Text {
        x: 24px;
        y: 186px;
        width: parent.width - 48px;
        height: 18px;
        text: root.strings.auth-cli;
        color: DesignTokens.text-muted;
        font-size: DesignTokens.text-caption;
    }
}
